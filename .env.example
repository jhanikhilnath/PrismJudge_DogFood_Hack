# ==============================================================================
# DOGFOOD 2026 — Environment Configuration Template
# Copy this file to .env to customize local or production settings:
#   cp .env.example .env
#
# NOTE: All variables below have built-in offline fallbacks to satisfy the
# competition's "One-Command Rule" (zero setup required for docker compose up).
# ==============================================================================

# Server Network Configuration
PORT=8080
HOST=0.0.0.0
BASE_URL=http://localhost:8080
NODE_ENV=production

# Security & Session Authentication
# In production, replace with a 64+ char random string (e.g. openssl rand -hex 32)
SESSION_SECRET=dogfood_2026_super_secure_offline_secret_key_99x

# Storage & Embedded SQLite Database
DB_PATH=./portal.sqlite
FIXTURES_PATH=./fixtures.json

# Judging & Mathematical Engine Tuning
# Prior pseudo-observation weight for Empirical Bayesian Shrinkage (default: 3.0)
SHRINKAGE_WEIGHT_M=3.0
# Dirichlet smoothing parameter for Bradley-Terry Pairwise solver (default: 0.10)
BRADLEY_TERRY_ALPHA=0.10
