{
  "name": "dogfood-portal",
  "version": "1.0.0",
  "description": "PrismJudge (DOGFOOD 2026) Hackathon Platform - Open source, self-hostable submission and judging platform",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp -r src/views dist/ && cp -r src/public dist/",
    "start": "node dist/index.js",
    "seed": "tsx src/db/seed.ts",
    "test": "tsx --test --test-concurrency=1 tests/**/*.test.ts",
    "test:security": "tsx tests/security_audit.test.ts"
  },
  "keywords": [
    "hackathon",
    "dogfood",
    "judging",
    "normalization",
    "fastify",
    "typescript"
  ],
  "author": "Nikhil Jha",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/view": "^10.0.2",
    "ejs": "^3.1.10",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
