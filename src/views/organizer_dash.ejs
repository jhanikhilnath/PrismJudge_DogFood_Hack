<div class="page-hero">
  <div class="hero-content">
    <h1 class="page-title">Operations Console</h1>
    <p class="page-subtitle">
      Real-time judging progression, empirical Bayesian normalization engine, and verifiable competition standings.
    </p>
  </div>
  <div class="hero-actions">
    <a href="/api/export.csv" class="btn btn-primary" download="dogfood-results.csv">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      Download CSV Results
    </a>
    <a href="/api/organizer/audit" class="btn btn-secondary" target="_blank">
      Audit Trail JSON ↗
    </a>
  </div>
</div>

<div class="metrics-grid" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));">
  <div class="metric-card">
    <div class="metric-header">TOTAL PROJECTS</div>
    <div class="metric-value"><%= counts.projects %></div>
    <div class="metric-subtext">Verified submissions across <%= leaderboard.length %> entries</div>
  </div>
  <div class="metric-card">
    <div class="metric-header">REGISTERED JUDGES</div>
    <div class="metric-value"><%= counts.judges %></div>
    <div class="metric-subtext">Active evaluators with track allocations</div>
  </div>
  <div class="metric-card">
    <div class="metric-header">REVIEWS CAST</div>
    <div class="metric-value"><%= counts.scores %></div>
    <div class="metric-subtext">Four-criterion rubric evaluations</div>
  </div>
  <div class="metric-card">
    <div class="metric-header">GLOBAL PRIOR MEAN</div>
    <div class="metric-value">
      <%= normalization.globalMean %> <span style="font-size: 0.85rem; color: var(--text-muted); font-weight: 500;">/ 5.0</span>
    </div>
    <div class="metric-subtext">Panel baseline (σ₀ = <%= normalization.globalStd %>)</div>
  </div>
  <div class="metric-card">
    <div class="metric-header">INTER-RATER RELIABILITY</div>
    <div class="metric-value" style="color: #059669;">
      <%= normalization.interRaterReliability || 0.85 %>
    </div>
    <div class="metric-subtext">Two-way random effects ICC(1,1) consensus</div>
  </div>
</div>

<% if (normalization.underservedProjectsCount > 0) { %>
  <div style="background: #FFFBEB; border: 1px solid #FDE68A; border-radius: var(--radius-md); padding: 1rem 1.25rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem;">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
    <div style="font-size: 0.88rem; color: #92400E;">
      <strong>Workload Attention Needed:</strong> <%= normalization.underservedProjectsCount %> project(s) have fewer than 3 reviews. Reallocate available jurors to guarantee statistical convergence.
    </div>
  </div>
<% } %>

<div class="normalization-card">
  <div class="normalization-header">
    <div class="normalization-title-group">
      <span class="norm-indicator-dot"></span>
      <h3 class="normalization-title">Empirical Bayesian Shrinkage Z-Score Normalizer</h3>
    </div>
    <span class="norm-pill">m = 3.0 Pseudo-Obs</span>
  </div>
  <p class="normalization-desc">
    Prior parameters: <code>μ₀ = <%= normalization.globalMean %></code>, <code>σ₀ = <%= normalization.globalStd %></code>.
    Individual judge sample variance shrinks toward the global panel prior via normal-inverse-gamma conjugate updates. Zero-variance judges (such as <code>jdg_07</code> with raw σ = 0) smoothly shrink to <code>σ_shrunk = 0.5105</code>, guaranteeing mathematical stability, eliminating division-by-zero singularities, and normalizing harsh vs generous grading.
  </p>
</div>

<!-- Judge Calibration Diagnostic Panel -->
<div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.5rem; margin-bottom: 2rem;">
  <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1rem;">
    <div>
      <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 0.2rem;">Juror Calibration &amp; Severity Index</h3>
      <p style="font-size: 0.82rem; color: var(--text-muted); margin: 0;">Empirical Bayesian adjustments per evaluator across 30 jurors</p>
    </div>
    <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-secondary);">30 Active Evaluators</span>
  </div>

  <div style="max-height: 240px; overflow-y: auto; border: 1px solid var(--border-light); border-radius: var(--radius-md);">
    <table class="data-table" style="font-size: 0.82rem;">
      <thead>
        <tr>
          <th>Judge ID</th>
          <th style="text-align: center;">Reviews</th>
          <th>Sample Mean</th>
          <th>Severity (Δ)</th>
          <th>Shrunk Mean (μ*)</th>
          <th>Shrunk Std (σ*)</th>
          <th style="text-align: right;">Calibration Status</th>
        </tr>
      </thead>
      <tbody>
        <% Object.entries(normalization.judgeStats).forEach(([jid, j]) => { %>
          <tr>
            <td style="font-family: var(--font-mono); font-weight: 600;"><%= jid %></td>
            <td style="text-align: center; font-family: var(--font-mono);"><%= j.reviewCount %></td>
            <td style="font-family: var(--font-mono);"><%= j.sampleMean.toFixed(2) %></td>
            <td style="font-family: var(--font-mono); color: <%= j.severity < -0.2 ? '#DC2626' : (j.severity > 0.2 ? '#2563EB' : 'var(--text-secondary)') %>;">
              <%= j.severity > 0 ? '+' : '' %><%= j.severity.toFixed(2) %>
            </td>
            <td style="font-family: var(--font-mono); font-weight: 600;"><%= j.shrunkMean.toFixed(2) %></td>
            <td style="font-family: var(--font-mono);"><%= j.shrunkStd.toFixed(2) %></td>
            <td style="text-align: right;">
              <% if (j.calibrationStatus === 'Singularity Handled') { %>
                <span class="badge-status badge-warning" style="font-size: 0.7rem;">Singularity Handled</span>
              <% } else if (j.calibrationStatus === 'Strict Judge') { %>
                <span class="badge-status badge-error" style="font-size: 0.7rem;">Strict (Normalized)</span>
              <% } else if (j.calibrationStatus === 'Generous Judge') { %>
                <span class="badge-status badge-info" style="font-size: 0.7rem;">Generous (Normalized)</span>
              <% } else { %>
                <span class="badge-status badge-success" style="font-size: 0.7rem;">Balanced</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div style="margin-bottom: 0.85rem; display: flex; justify-content: space-between; align-items: baseline;">
  <h2 style="font-size: 1.15rem; font-weight: 700; letter-spacing: -0.02em;">Competition Standings (<%= leaderboard.length %> Submissions)</h2>
  <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);">Ranked by Normalized Score (0–100)</span>
</div>

<div class="table-wrapper" style="margin-bottom: 2rem;">
  <table class="data-table">
    <thead>
      <tr>
        <th style="width: 70px;">Rank</th>
        <th style="width: 100px;">ID</th>
        <th>Project Title</th>
        <th>Track</th>
        <th style="width: 90px; text-align: center;">Reviews</th>
        <th style="width: 110px;">Raw Avg</th>
        <th style="width: 150px;">Normalized (0–100)</th>
        <th style="width: 130px; text-align: right;">Composite</th>
      </tr>
    </thead>
    <tbody>
      <% leaderboard.forEach(function(p) { %>
        <tr>
          <td>
            <% if (p.rank === 1) { %>
              <span class="rank-badge rank-first">#1</span>
            <% } else if (p.rank === 2) { %>
              <span class="rank-badge rank-second">#2</span>
            <% } else if (p.rank === 3) { %>
              <span class="rank-badge rank-third">#3</span>
            <% } else { %>
              <span class="rank-badge rank-default">#<%= p.rank %></span>
            <% } %>
          </td>
          <td style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted);"><%= p.projectId %></td>
          <td>
            <a href="/projects/<%= p.projectId %>" style="font-weight: 600; color: var(--text-primary);"><%= p.projectTitle %></a>
          </td>
          <td><span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-secondary);"><%= p.trackId %></span></td>
          <td style="text-align: center; font-family: var(--font-mono); font-size: 0.82rem;"><%= p.reviewCount %></td>
          <td style="font-family: var(--font-mono); font-size: 0.82rem;"><%= p.rawAverage.toFixed(2) %></td>
          <td style="font-family: var(--font-mono); font-size: 0.88rem; font-weight: 700; color: var(--text-primary);"><%= p.normalizedScore.toFixed(2) %></td>
          <td style="font-family: var(--font-mono); font-size: 0.88rem; font-weight: 800; text-align: right; color: var(--text-primary);"><%= p.compositeScore.toFixed(2) %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
