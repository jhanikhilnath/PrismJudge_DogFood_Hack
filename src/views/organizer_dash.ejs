<div class="page-hero">
  <div class="hero-content">
    <h1 class="page-title">Operations Console</h1>
    <p class="page-subtitle">
      Real-time judging progression, empirical Bayesian normalization engine, and verifiable competition standings.
    </p>
  </div>
  <div class="hero-actions" style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
    <a href="/api/export.csv" class="btn btn-primary" download="dogfood-results.csv">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      Download CSV Results
    </a>
    <select id="select-export-stage" onchange="if(this.value){window.location.href='/api/export.csv?stage='+this.value;}" class="btn btn-secondary" style="padding: 0.45rem 0.6rem; font-size: 0.8rem; cursor: pointer; background: var(--bg-surface);">
      <option value="">Export Stage...</option>
      <option value="composite">Composite Standings (Official)</option>
      <option value="raw">Raw Evaluator Rubric Scores</option>
      <option value="normalized">Bayesian Normalized Ratings</option>
      <option value="pairwise">Pairwise Match Showdowns</option>
      <option value="audit">System Audit Ledger</option>
    </select>
    <a href="/normalization-proof.txt" class="btn btn-secondary" target="_blank">
      Proof Artifact (.txt) ↗
    </a>
    <a href="/api/organizer/audit" class="btn btn-secondary" target="_blank">
      Audit Trail JSON ↗
    </a>
  </div>
</div>

<div class="metrics-grid" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));">
  <div class="metric-card">
    <div class="metric-header">TOTAL PROJECTS</div>
    <div class="metric-value"><%= counts.projects %></div>
    <div class="metric-subtext">Verified submissions across <%= leaderboard.length %> entries</div>
  </div>
  <div class="metric-card">
    <div class="metric-header">REGISTERED JUDGES</div>
    <div class="metric-value"><%= counts.judges %></div>
    <div class="metric-subtext">Active evaluators with track allocations</div>
  </div>
  <div class="metric-card">
    <div class="metric-header">REVIEWS CAST</div>
    <div class="metric-value"><%= counts.scores %></div>
    <div class="metric-subtext">Four-criterion rubric evaluations</div>
  </div>
  <div class="metric-card">
    <div class="metric-header">COMMUNITY BALLOTS</div>
    <div class="metric-value"><%= typeof counts.votes !== 'undefined' ? counts.votes : 0 %></div>
    <div class="metric-subtext">Verified community &amp; peer ballots cast</div>
  </div>
  <div class="metric-card">
    <div class="metric-header">GLOBAL PRIOR MEAN</div>
    <div class="metric-value">
      <%= normalization.globalMean %> <span style="font-size: 0.85rem; color: var(--text-muted); font-weight: 500;">/ 5.0</span>
    </div>
    <div class="metric-subtext">Panel baseline (σ₀ = <%= normalization.globalStd %>)</div>
  </div>
  <div class="metric-card">
    <div class="metric-header">INTER-RATER RELIABILITY</div>
    <div class="metric-value" style="color: <%= normalization.interRaterReliability >= 0.75 ? '#059669' : (normalization.interRaterReliability >= 0.5 ? '#D97706' : '#DC2626') %>;">
      <%= normalization.interRaterReliability.toFixed(2) %>
    </div>
    <div class="metric-subtext">
      <% if (normalization.interRaterReliability >= 0.75) { %>
        Two-way random effects ICC(1,1) consensus: Good
      <% } else if (normalization.interRaterReliability >= 0.5) { %>
        Two-way random effects ICC(1,1) consensus: Moderate
      <% } else { %>
        Two-way random effects ICC(1,1) consensus: Low (Normalizer Active)
      <% } %>
    </div>
  </div>
</div>

<% if (normalization.underservedProjectsCount > 0) { %>
  <div style="background: #FFFBEB; border: 1px solid #FDE68A; border-radius: var(--radius-md); padding: 1.25rem; margin-bottom: 1.5rem; display: flex; align-items: flex-start; gap: 0.85rem;">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
    <div style="font-size: 0.88rem; color: #92400E; width: 100%;">
      <div style="font-weight: 700; margin-bottom: 0.35rem;">Workload Attention Needed: <%= normalization.underservedProjectsCount %> project(s) have fewer than 3 reviews</div>
      <div style="display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.4rem;">
        <% leaderboard.filter(p => p.reviewCount < 3).forEach(p => { %>
          <a href="/projects/<%= p.projectId %>" style="display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.2rem 0.55rem; background: #FEF3C7; border: 1px solid #FCD34D; border-radius: 4px; font-family: var(--font-mono); font-size: 0.75rem; color: #78350F; text-decoration: none;">
            <strong><%= p.projectId %></strong> <%= p.projectTitle %> <span style="background: #FDE68A; padding: 0.05rem 0.3rem; border-radius: 3px; font-weight: 700;"><%= p.reviewCount %>/3</span>
          </a>
        <% }) %>
      </div>
      <div style="font-size: 0.8rem; color: #B45309;">Reallocate available jurors to guarantee statistical convergence across all submissions.</div>
    </div>
  </div>
<% } %>

<div class="normalization-card">
  <div class="normalization-header">
    <div class="normalization-title-group">
      <span class="norm-indicator-dot"></span>
      <h3 class="normalization-title">Fair Score Calibration System</h3>
    </div>
    <span class="norm-pill">Active Equalization</span>
  </div>
  <p class="normalization-desc">
    Scores are automatically balanced across all 30 evaluators to neutralize strict versus lenient grading habits. Every submission is evaluated against an impartial, standardized scale.
  </p>
  <details style="margin-top: 0.75rem; font-size: 0.8rem; color: var(--text-muted); cursor: pointer;">
    <summary style="font-weight: 600; color: var(--text-secondary); outline: none;">Technical Calibration Proof &amp; Methodology</summary>
    <div style="padding: 0.75rem; margin-top: 0.5rem; background: var(--bg-surface-elevated); border-radius: var(--radius-sm); border: 1px solid var(--border-light); font-size: 0.8rem; line-height: 1.5;">
      Uses Empirical Bayesian Normalization. Prior parameters: <code>μ₀ = <%= normalization.globalMean %></code>, <code>σ₀ = <%= normalization.globalStd %></code> (m = 3.0). Evaluator variance smoothly shrinks toward the panel prior, resolving zero-variance judges (such as <code>jdg_07</code> with raw σ = 0) to <code>σ* = 0.5105</code> without singularities.
    </div>
  </details>
</div>

<!-- Judge Calibration Diagnostic Panel -->
<div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.5rem; margin-bottom: 2rem;">
  <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1rem;">
    <div>
      <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 0.2rem;">Juror Calibration &amp; Severity Index</h3>
      <p style="font-size: 0.82rem; color: var(--text-muted); margin: 0;">Automated balance adjustments per evaluator across 30 jurors</p>
    </div>
    <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-secondary);">30 Active Evaluators</span>
  </div>

  <div style="max-height: 280px; overflow: auto; border: 1px solid var(--border-light); border-radius: var(--radius-md);">
    <table class="data-table" style="font-size: 0.82rem;">
      <thead>
        <tr>
          <th>Judge ID</th>
          <th>Evaluator</th>
          <th style="text-align: center;">Reviews</th>
          <th>Raw Average</th>
          <th>Severity Offset</th>
          <th>Calibrated Mean (μ*)</th>
          <th>Calibrated Spread (σ*)</th>
          <th style="text-align: right;">Calibration Status</th>
        </tr>
      </thead>
      <tbody>
        <% 
          const judgeMap = new Map((typeof judgeProgress !== 'undefined' ? judgeProgress : []).map(jp => [jp.id, jp]));
          Object.entries(normalization.judgeStats).forEach(([jid, j]) => { 
            const jInfo = judgeMap.get(jid);
        %>
          <tr>
            <td style="font-family: var(--font-mono); font-weight: 600;"><%= jid %></td>
            <td>
              <div style="font-weight: 600; color: var(--text-primary);"><%= jInfo ? jInfo.name : jid %></div>
              <div style="font-size: 0.72rem; color: var(--text-muted);"><%= (jInfo && jInfo.email) ? jInfo.email : '' %></div>
            </td>
            <td style="text-align: center; font-family: var(--font-mono);"><%= j.reviewCount %></td>
            <td style="font-family: var(--font-mono);"><%= j.sampleMean.toFixed(2) %></td>
            <td style="font-family: var(--font-mono); color: <%= j.severity < -0.2 ? '#DC2626' : (j.severity > 0.2 ? '#2563EB' : 'var(--text-secondary)') %>;">
              <%= j.severity > 0 ? '+' : '' %><%= j.severity.toFixed(2) %>
            </td>
            <td style="font-family: var(--font-mono); font-weight: 600;"><%= j.shrunkMean.toFixed(2) %></td>
            <td style="font-family: var(--font-mono);"><%= j.shrunkStd.toFixed(2) %></td>
            <td style="text-align: right;">
              <% if (j.calibrationStatus === 'Singularity Handled') { %>
                <span class="badge-status badge-warning" style="font-size: 0.7rem;">Singularity Handled</span>
              <% } else if (j.calibrationStatus === 'Strict Judge') { %>
                <span class="badge-status badge-error" style="font-size: 0.7rem;">Strict (Normalized)</span>
              <% } else if (j.calibrationStatus === 'Generous Judge') { %>
                <span class="badge-status badge-info" style="font-size: 0.7rem;">Generous (Normalized)</span>
              <% } else { %>
                <span class="badge-status badge-success" style="font-size: 0.7rem;">Balanced</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div style="margin-bottom: 0.85rem; display: flex; justify-content: space-between; align-items: baseline;">
  <h2 style="font-size: 1.15rem; font-weight: 700; letter-spacing: -0.02em;">Competition Standings (<%= leaderboard.length %> Submissions)</h2>
  <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);">Ranked by Composite Score (80% Calibrated Rubric + 20% Pairwise Matchups)</span>
</div>

<div class="table-wrapper" style="margin-bottom: 2.5rem;">
  <table class="data-table">
    <thead>
      <tr>
        <th style="width: 105px;">Rank &amp; Shift</th>
        <th style="width: 90px;">ID</th>
        <th>Project Title</th>
        <th>Track</th>
        <th style="width: 90px; text-align: center;">Reviews</th>
        <th style="width: 110px;">Raw Avg</th>
        <th style="width: 140px;">Normalized</th>
        <th style="width: 130px; text-align: right;">Composite Score</th>
      </tr>
    </thead>
    <tbody>
      <% leaderboard.forEach(function(p) { %>
        <tr>
          <td>
            <div style="display: flex; align-items: center; gap: 0.35rem;">
              <% if (p.rank === 1) { %>
                <span class="rank-badge rank-first">#1</span>
              <% } else if (p.rank === 2) { %>
                <span class="rank-badge rank-second">#2</span>
              <% } else if (p.rank === 3) { %>
                <span class="rank-badge rank-third">#3</span>
              <% } else { %>
                <span class="rank-badge rank-default">#<%= p.rank %></span>
              <% } %>
              <% if (typeof p.rankDelta !== 'undefined' && p.rankDelta !== 0) { %>
                <span class="badge-status <%= p.rankDelta > 0 ? 'badge-success' : 'badge-danger' %>" style="font-family: var(--font-mono); font-size: 0.65rem; padding: 0.1rem 0.35rem; border-radius: 4px;" title="Movement from raw rank (#<%= p.rawRank %> → #<%= p.rank %>)">
                  <%= p.rankDelta > 0 ? '+' + p.rankDelta : p.rankDelta %>
                </span>
              <% } else { %>
                <span style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--text-muted); padding: 0.1rem 0.2rem;" title="Rank unchanged from raw score">=</span>
              <% } %>
            </div>
          </td>
          <td style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted);"><%= p.projectId %></td>
          <td>
            <a href="/projects/<%= p.projectId %>" style="font-weight: 600; color: var(--text-primary);"><%= p.projectTitle %></a>
            <% if (p.reviewCount < 3) { %>
              <span class="badge-status badge-warning" style="font-size: 0.68rem; margin-left: 0.4rem;" title="Fewer than 3 reviews">Needs Review (<%= p.reviewCount %>/3)</span>
            <% } %>
          </td>
          <td><span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-secondary);"><%= p.trackId %></span></td>
          <td style="text-align: center; font-family: var(--font-mono); font-size: 0.82rem;"><%= p.reviewCount %></td>
          <td style="font-family: var(--font-mono); font-size: 0.82rem;"><%= p.rawAverage.toFixed(2) %></td>
          <td style="font-family: var(--font-mono); font-size: 0.88rem; font-weight: 600; color: var(--text-primary);"><%= p.normalizedScore.toFixed(2) %></td>
          <td style="font-family: var(--font-mono); font-size: 0.92rem; font-weight: 800; text-align: right; color: var(--accent-blue);"><%= p.compositeScore.toFixed(2) %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<!-- Embedded Immutable Audit Ledger -->
<div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.5rem; margin-bottom: 2rem;">
  <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1rem;">
    <div>
      <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 0.2rem;">System Audit Ledger</h3>
      <p style="font-size: 0.82rem; color: var(--text-muted); margin: 0;">Append-only cryptographic mutation log for compliance and verification</p>
    </div>
    <a href="/api/organizer/audit" target="_blank" class="btn btn-secondary btn-sm" style="font-size: 0.75rem;">
      Full JSON Feed ↗
    </a>
  </div>

  <div style="max-height: 260px; overflow-y: auto; border: 1px solid var(--border-light); border-radius: var(--radius-md);">
    <table class="data-table" style="font-size: 0.8rem;">
      <thead>
        <tr>
          <th>Timestamp</th>
          <th>Actor</th>
          <th>Role</th>
          <th>Action</th>
          <th>Resource</th>
        </tr>
      </thead>
      <tbody>
        <% if (typeof recentAuditLogs !== 'undefined' && recentAuditLogs.length > 0) { %>
          <% recentAuditLogs.forEach(function(log) { %>
            <tr>
              <td style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); white-space: nowrap;">
                <%= new Date(log.created_at).toLocaleString() %>
              </td>
              <td style="font-family: var(--font-mono); font-weight: 600;"><%= log.actor_id %></td>
              <td><span class="badge-status badge-default" style="font-size: 0.68rem;"><%= log.actor_role %></span></td>
              <td style="font-family: var(--font-mono); font-weight: 600; color: var(--text-primary);"><%= log.action %></td>
              <td style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-secondary);">
                <%= log.resource_type %><%= log.resource_id ? ' (' + log.resource_id + ')' : '' %>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="5" style="text-align: center; color: var(--text-muted); padding: 1.5rem;">
              No audit events recorded in current session.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
