<!-- Certificate Action Bar (Hidden during print) -->
<div class="cert-action-bar no-print">
  <a href="/judge/dashboard" class="btn btn-secondary btn-sm">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    Return to Judging Dashboard
  </a>

  <div class="cert-status-badge">
    <span class="cert-status-dot"></span>
    <span>Official Verified Evaluator Credential</span>
  </div>

  <button onclick="window.print()" class="btn btn-primary btn-sm">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
    Print / Save as PDF
  </button>
</div>

<!-- Elite Diploma / Credential Sheet -->
<div class="diploma-wrapper">
  <div class="diploma-sheet" id="diploma-sheet">
    <!-- Guilloche Background Watermark (Pure Vector SVG) -->
    <div class="diploma-watermark" aria-hidden="true">
      <svg width="420" height="420" viewBox="0 0 200 200" fill="none" opacity="0.035">
        <circle cx="100" cy="100" r="90" stroke="#0F172A" stroke-width="1" stroke-dasharray="2 3"/>
        <circle cx="100" cy="100" r="75" stroke="#0F172A" stroke-width="0.8"/>
        <polygon points="100,15 124,76 185,100 124,124 100,185 76,124 15,100 76,76" stroke="#0F172A" stroke-width="0.75"/>
        <polygon points="100,25 118,82 175,100 118,118 100,175 82,118 25,100 82,82" stroke="#0F172A" stroke-width="0.5"/>
        <circle cx="100" cy="100" r="45" stroke="#0F172A" stroke-width="1.2"/>
        <circle cx="100" cy="100" r="30" stroke="#0F172A" stroke-width="0.6"/>
      </svg>
    </div>

    <!-- Outer Ornamental Frame -->
    <div class="diploma-frame-outer">
      <!-- Inner Ornamental Frame -->
      <div class="diploma-frame-inner">
        <!-- Corner Accents -->
        <div class="cert-corner corner-tl">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M2 12V2H12M2 2L8 8" stroke="#D97706" stroke-width="1.5"/></svg>
        </div>
        <div class="cert-corner corner-tr">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M22 12V2H12M22 2L16 8" stroke="#D97706" stroke-width="1.5"/></svg>
        </div>
        <div class="cert-corner corner-bl">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M2 12V22H12M2 22L8 16" stroke="#D97706" stroke-width="1.5"/></svg>
        </div>
        <div class="cert-corner corner-br">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M22 12V22H12M22 22L16 16" stroke="#D97706" stroke-width="1.5"/></svg>
        </div>

        <!-- Certificate Header -->
        <div class="diploma-header">
          <div class="diploma-logo-mark">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <div class="diploma-org-name">DOGFOOD 2026 EVALUATION COMMITTEE</div>
          <div class="diploma-title">CERTIFICATE OF JUROR COMMENDATION</div>
          <div class="diploma-subtitle">RECOGNITION OF EXEMPLARY TECHNICAL EVALUATION SERVICE</div>
        </div>

        <!-- Certificate Body -->
        <div class="diploma-body">
          <p class="diploma-presented-to">This credential is honorably awarded to</p>

          <div class="diploma-recipient-name">
            <%= judge.name %>
          </div>

          <div class="diploma-citation">
            In formal recognition of distinguished service as a <strong>Technical Evaluator &amp; Juror</strong> for the DOGFOOD 2026 Global Hackathon. Through rigorous 4-criterion technical assessment, impartial grading discipline, and pairwise comparative deliberation, this juror contributed substantially to competition integrity and the fair determination of champion platforms.
          </div>

          <!-- Evaluator Metrics Card -->
          <div class="diploma-project-card" style="display: flex; justify-content: space-around; text-align: center;">
            <div>
              <div class="diploma-project-label">ASSIGNED TRACKS</div>
              <div style="font-weight: 700; font-size: 0.95rem; color: var(--text-primary);">
                <%= tracks.length > 0 ? tracks.join(', ') : 'All Tracks' %>
              </div>
            </div>
            <div>
              <div class="diploma-project-label">SUBMISSIONS REVIEWED</div>
              <div style="font-weight: 700; font-size: 0.95rem; color: var(--accent);">
                <%= reviewsCount %> Submissions
              </div>
            </div>
            <div>
              <div class="diploma-project-label">COMMITTEE STATUS</div>
              <div style="font-weight: 700; font-size: 0.95rem; color: #059669;">
                Active &amp; Verified
              </div>
            </div>
          </div>
        </div>

        <!-- Certificate Signatures & Gold Seal Medallion -->
        <div class="diploma-footer">
          <div class="diploma-sig-col">
            <div class="signature-line">
              <svg width="150" height="42" viewBox="0 0 150 42" fill="none">
                <path d="M10 28 C 30 10, 45 35, 65 18 C 75 10, 85 24, 100 14 C 115 6, 125 30, 140 20" stroke="#1E293B" stroke-width="1.8" stroke-linecap="round" fill="none"/>
              </svg>
            </div>
            <div class="sig-name">Dr. Marcus Vance</div>
            <div class="sig-title">Judging Committee Chair</div>
          </div>

          <!-- Official Gold Seal Medallion -->
          <div class="cert-gold-seal" aria-label="Official Verified Seal">
            <div class="seal-outer-ring">
              <div class="seal-inner-ring">
                <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="#92400E" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
                <span class="seal-text-top">OFFICIAL</span>
                <span class="seal-text-bottom">EVALUATOR</span>
              </div>
            </div>
          </div>

          <div class="diploma-sig-col">
            <div class="signature-line">
              <svg width="150" height="42" viewBox="0 0 150 42" fill="none">
                <path d="M12 25 C 28 32, 50 12, 70 24 C 85 30, 100 12, 115 18 C 128 22, 135 15, 142 22" stroke="#1E293B" stroke-width="1.8" stroke-linecap="round" fill="none"/>
              </svg>
            </div>
            <div class="sig-name">Helena Sterling</div>
            <div class="sig-title">Lead Hackathon Coordinator</div>
          </div>
        </div>

        <!-- Security & Public Provenance Strip -->
        <div class="diploma-audit-strip">
          <span>CREDENTIAL ID: <code>DF26-JDG-<%= judge.id.toUpperCase() %></code></span>
          <span>ISSUED: <time datetime="<%= judge.created_at %>">September 2026</time></span>
          <span>INTEGRITY SEAL: <code>HMAC-SHA256 (<%= signature.substring(0, 16) %>...)</code></span>
          <span>VERIFY: <code>/certificates/judge/<%= judge.id %>/verify</code></span>
        </div>
      </div>
    </div>
  </div>
</div>
