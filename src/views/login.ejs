<div class="login-wrapper">
  <div class="login-header-block">
    <h1 class="page-title">Sign In to Dogfood</h1>
    <p class="page-subtitle" style="margin: 0 auto;">
      Access role-gated evaluation portals, submission consoles, and audit records.
    </p>
  </div>

  <% if (error) { %>
    <div class="security-banner" style="background: #FEF2F2; border-color: #FECDD3; color: #991B1B; margin-bottom: 1.5rem;">
      <svg class="security-icon" style="color: #DC2626;" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <div class="security-text" style="color: #991B1B; font-weight: 500;">
        <%= error %>
      </div>
    </div>
  <% } %>

  <div class="auth-tabs-bar">
    <button type="button" class="auth-tab-btn active" data-tab="tab-personas" onclick="switchAuthTab('tab-personas')">Demo Personas (1-Click)</button>
    <button type="button" class="auth-tab-btn" data-tab="tab-credentials" onclick="switchAuthTab('tab-credentials')">Email &amp; Password</button>
    <button type="button" class="auth-tab-btn" data-tab="tab-token" onclick="switchAuthTab('tab-token')">Direct Token</button>
  </div>

  <!-- Tab 1: Demo Personas -->
  <div id="tab-personas" class="auth-tab-pane">
    <div class="persona-cards-grid">
      <!-- Organizer -->
      <div class="persona-card">
        <div>
          <div class="persona-card-header">
            <div>
              <h3 class="persona-card-title">Lead Organizer</h3>
              <div class="persona-card-sub">organizer@example.org</div>
            </div>
            <span class="item-tag tag-org">ORG</span>
          </div>
          <p class="persona-card-desc">
            Control room access, live Bayesian Z-score normalization metrics, and CSV export.
          </p>
        </div>
        <form action="/login" method="POST">
          <input type="hidden" name="persona" value="organizer">
          <input type="hidden" name="redirect" value="<%= redirect %>">
          <button type="submit" class="btn btn-primary btn-sm" style="width: 100%;">
            Enter as Organizer →
          </button>
        </form>
      </div>

      <!-- Judge A -->
      <div class="persona-card">
        <div>
          <div class="persona-card-header">
            <div>
              <h3 class="persona-card-title">Judge A (Lead)</h3>
              <div class="persona-card-sub">Tomas Varga · jdg_01</div>
            </div>
            <span class="item-tag tag-judge">JUDGE</span>
          </div>
          <p class="persona-card-desc">
            Review assigned entries, calibrate rubric sliders, and verify peer isolation.
          </p>
        </div>
        <form action="/login" method="POST">
          <input type="hidden" name="persona" value="judge_a">
          <input type="hidden" name="redirect" value="<%= redirect %>">
          <button type="submit" class="btn btn-secondary btn-sm" style="width: 100%;">
            Enter as Judge A →
          </button>
        </form>
      </div>

      <!-- Judge B -->
      <div class="persona-card">
        <div>
          <div class="persona-card-header">
            <div>
              <h3 class="persona-card-title">Judge B (Peer)</h3>
              <div class="persona-card-sub">Elena Chen · jdg_02</div>
            </div>
            <span class="item-tag tag-judge">JUDGE</span>
          </div>
          <p class="persona-card-desc">
            Independent evaluator. Cryptographically blocked from inspecting Judge A scores.
          </p>
        </div>
        <form action="/login" method="POST">
          <input type="hidden" name="persona" value="judge_b">
          <input type="hidden" name="redirect" value="<%= redirect %>">
          <button type="submit" class="btn btn-secondary btn-sm" style="width: 100%;">
            Enter as Judge B →
          </button>
        </form>
      </div>

      <!-- Participant -->
      <div class="persona-card">
        <div>
          <div class="persona-card-header">
            <div>
              <h3 class="persona-card-title">Participant</h3>
              <div class="persona-card-sub">Team 01 · usr_part</div>
            </div>
            <span class="item-tag tag-part">PARTICIPANT</span>
          </div>
          <p class="persona-card-desc">
            Contestant view. View submission status, cast ballots, and test permission gates.
          </p>
        </div>
        <form action="/login" method="POST">
          <input type="hidden" name="persona" value="participant">
          <input type="hidden" name="redirect" value="<%= redirect %>">
          <button type="submit" class="btn btn-secondary btn-sm" style="width: 100%;">
            Enter as Participant →
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Tab 2: Email & Password -->
  <div id="tab-credentials" class="auth-tab-pane" style="display: none; max-width: 440px; margin: 0 auto;">
    <div class="form-card">
      <form action="/login" method="POST">
        <input type="hidden" name="redirect" value="<%= redirect %>">
        
        <div class="form-group">
          <label class="form-label" for="login-email">Email Address</label>
          <input type="email" id="login-email" name="email" required class="form-input" placeholder="organizer@example.org" autocomplete="email">
        </div>

        <div class="form-group">
          <label class="form-label" for="login-password">Password</label>
          <input type="password" id="login-password" name="password" required class="form-input" placeholder="••••••••••••" autocomplete="current-password">
        </div>

        <div style="margin-top: 1.5rem;">
          <button type="submit" class="btn btn-primary" style="width: 100%;">Sign In</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Tab 3: Direct Token -->
  <div id="tab-token" class="auth-tab-pane" style="display: none; max-width: 440px; margin: 0 auto;">
    <div class="form-card">
      <form action="/login" method="POST">
        <input type="hidden" name="redirect" value="<%= redirect %>">

        <div class="form-group">
          <label class="form-label" for="login-token">Session Token</label>
          <input type="text" id="login-token" name="token" required class="form-input" placeholder="e.g. org_7f2a" style="font-family: var(--font-mono);">
          <span style="font-size: 0.75rem; color: var(--text-muted); display: block; margin-top: 0.35rem;">
            Demo tokens: <code>org_7f2a</code>, <code>jdg_a_91bc</code>, <code>jdg_b_44de</code>, <code>prt_2e88</code>
          </span>
        </div>

        <div style="margin-top: 1.5rem;">
          <button type="submit" class="btn btn-primary" style="width: 100%;">Authenticate with Token</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function switchAuthTab(tabId) {
    document.querySelectorAll('.auth-tab-btn').forEach(btn => {
      btn.classList.toggle('active', btn.getAttribute('data-tab') === tabId);
    });
    document.querySelectorAll('.auth-tab-pane').forEach(pane => {
      pane.style.display = pane.id === tabId ? 'block' : 'none';
    });
  }
</script>
