<div class="breadcrumb-nav" style="max-width: 720px; margin-left: auto; margin-right: auto;">
  <a href="/projects/<%= project.id %>" class="breadcrumb-link">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    Back to <%= project.title %>
  </a>
</div>

<div class="certificate-container" style="max-width: 720px; margin: 0 auto; background: #FFFFFF; border: 1px solid var(--border); border-radius: var(--radius-xl); padding: 3.5rem 3rem; box-shadow: var(--shadow-sm); text-align: center;">
  <div style="font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; color: var(--text-muted); letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 1.5rem;">
    Official Record of Participation · Sample Hack 2026
  </div>

  <h1 style="font-size: 2.25rem; font-weight: 800; letter-spacing: -0.03em; color: var(--text-primary); margin-bottom: 0.75rem; line-height: 1.2;">
    <%= project.title %>
  </h1>

  <p style="font-size: 1rem; color: var(--text-secondary); margin-bottom: 2.25rem; line-height: 1.6; max-width: 520px; margin-left: auto; margin-right: auto;">
    This certifies that <strong><%= project.team_name || project.team_id %></strong> has successfully engineered and submitted this project in the <strong><%= project.track_name || 'General' %></strong> track.
  </p>

  <div style="background: #FAFAFA; border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1.25rem 1.5rem; text-align: left; margin-bottom: 2rem; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
    <div>
      <div style="font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">CERTIFICATE NUMBER</div>
      <div style="font-family: var(--font-mono); font-size: 0.85rem; font-weight: 600; color: var(--text-primary); margin-top: 0.2rem;">
        DF26-<%= project.id.toUpperCase() %>-<%= signature.slice(0, 8).toUpperCase() %>
      </div>
    </div>
    <div>
      <div style="font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">DATE OF RECORD</div>
      <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.2rem;">
        March 1, 2026
      </div>
    </div>
  </div>

  <div style="display: flex; justify-content: center; gap: 0.75rem;">
    <button onclick="window.print()" class="btn btn-primary">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
      Print / Save Certificate
    </button>
    <a href="/projects/<%= project.id %>" class="btn btn-secondary">
      Return to Project
    </a>
  </div>
</div>
