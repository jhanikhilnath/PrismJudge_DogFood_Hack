<div class="certificate-container">
  <div class="certificate-inner-border">
    <div class="certificate-badge">
      VERIFIABLE PARTICIPATION RECORD · 2026
    </div>

    <h1 class="certificate-title">
      <%= project.title %>
    </h1>

    <p class="certificate-subtitle">
      Engineered by <strong><%= project.team_name || project.team_id %></strong> within the <strong><%= project.track_name || 'General' %></strong> track.
    </p>

    <div class="crypto-signature-box">
      <div class="crypto-label">CRYPTOGRAPHIC VERIFICATION RECORD (HMAC-SHA256):</div>
      <code class="crypto-hash"><%= signature %></code>
      <div class="crypto-timestamp">SUBMISSION TIMESTAMP (UTC): <%= project.submitted_at %></div>
    </div>

    <div class="certificate-actions">
      <a href="/projects/<%= project.id %>" class="btn btn-secondary">← Back to Project</a>
      <button onclick="window.print()" class="btn btn-primary">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 0.35rem;"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
        Print Certificate
      </button>
    </div>
  </div>
</div>
