<div class="page-hero">
  <div>
    <div class="badge-role badge-judge" style="margin-bottom: 0.5rem; display: inline-block;">JUDGING CONSOLE</div>
    <h1 class="page-title">Evaluation Portal</h1>
    <p class="page-subtitle">
      Authenticated as <strong><%= user.name %></strong> (<%= user.userId %>) · <%= completedCount %> of <%= totalAssigned %> reviews completed
    </p>
  </div>
  <div style="display: flex; gap: 0.75rem;">
    <a href="/judge/pairwise" class="btn btn-secondary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 0.35rem;"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
      Pairwise Arena
    </a>
  </div>
</div>

<!-- Security & Isolation Assurance Banner -->
<div class="security-banner">
  <div class="security-icon">🔒</div>
  <div class="security-text">
    <strong>Peer Isolation Active:</strong> Backend access control strictly confines score access to your authenticated credentials. Cross-judge snooping attempts via query parameters or API IDOR probes are blocked with HTTP 403.
  </div>
</div>

<div class="table-wrapper">
  <table class="data-table">
    <thead>
      <tr>
        <th style="width: 120px;">Project ID</th>
        <th>Project Title</th>
        <th>Track</th>
        <th style="width: 140px;">Status</th>
        <th style="width: 130px;">Score</th>
        <th style="width: 110px; text-align: right;">Action</th>
      </tr>
    </thead>
    <tbody>
      <% assigned.forEach(function(p) { %>
        <tr>
          <td style="font-family: var(--font-mono); font-weight: 700; color: var(--text-dim);"><%= p.id %></td>
          <td>
            <a href="/projects/<%= p.id %>" style="font-weight: 600; color: var(--text-main);"><%= p.title %></a>
          </td>
          <td><span class="card-track"><%= p.track_name || 'General' %></span></td>
          <td>
            <% if (p.hasScored) { %>
              <span class="status-pill status-completed">✓ SCORED</span>
            <% } else { %>
              <span class="status-pill status-pending">PENDING</span>
            <% } %>
          </td>
          <td style="font-family: var(--font-mono); font-weight: 700;">
            <%= p.hasScored && p.score ? p.score.raw_total.toFixed(2) + ' / 5.0' : '—' %>
          </td>
          <td style="text-align: right;">
            <button 
              type="button"
              class="btn btn-secondary btn-sm" 
              data-project-id="<%= p.id %>"
              data-project-title="<%= p.title %>"
              onclick="openScoringModal(this.dataset.projectId, this.dataset.projectTitle)"
            >
              <%= p.hasScored ? 'Update' : 'Evaluate' %>
            </button>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<!-- Refined Scoring Modal Overlay -->
<div id="scoring-modal" class="modal-backdrop" style="display: none;" onclick="if(event.target===this) closeModal()">
  <div class="modal-dialog">
    <div class="modal-header">
      <h2 id="modal-project-title" class="modal-title">Score Project</h2>
      <button type="button" class="btn-close-modal" onclick="closeModal()">✕</button>
    </div>
    
    <form id="scoring-form" onsubmit="submitScore(event)">
      <input type="hidden" id="modal-project-id" name="project_id">

      <div class="form-group">
        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.35rem;">
          <label class="form-label" style="margin: 0;">Functionality (40% Weight)</label>
          <span id="val-func" class="rubric-val-chip">3</span>
        </div>
        <input type="range" min="1" max="5" step="1" value="3" id="score-func" class="rubric-input" data-weight="0.4" oninput="document.getElementById('val-func').textContent = this.value; updateModalScore();">
        <div class="slider-scale-labels">
          <span>1 (Broken)</span>
          <span>3 (Acceptable)</span>
          <span>5 (Flawless)</span>
        </div>
      </div>

      <div class="form-group">
        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.35rem;">
          <label class="form-label" style="margin: 0;">Quality &amp; Architecture (30% Weight)</label>
          <span id="val-qual" class="rubric-val-chip">3</span>
        </div>
        <input type="range" min="1" max="5" step="1" value="3" id="score-qual" class="rubric-input" data-weight="0.3" oninput="document.getElementById('val-qual').textContent = this.value; updateModalScore();">
        <div class="slider-scale-labels">
          <span>1 (Messy)</span>
          <span>3 (Solid)</span>
          <span>5 (Senior Grade)</span>
        </div>
      </div>

      <div class="form-group">
        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.35rem;">
          <label class="form-label" style="margin: 0;">Innovation &amp; Impact (30% Weight)</label>
          <span id="val-innov" class="rubric-val-chip">3</span>
        </div>
        <input type="range" min="1" max="5" step="1" value="3" id="score-innov" class="rubric-input" data-weight="0.3" oninput="document.getElementById('val-innov').textContent = this.value; updateModalScore();">
        <div class="slider-scale-labels">
          <span>1 (Derivative)</span>
          <span>3 (Novel)</span>
          <span>5 (Groundbreaking)</span>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Private Judge Feedback (Optional)</label>
        <textarea id="score-comment" class="form-textarea" rows="2" placeholder="Constructive evaluation notes for organizers and scoring records..."></textarea>
      </div>

      <div class="modal-footer">
        <div class="computed-score-box">
          <span class="computed-label">TOTAL SCORE</span>
          <div class="computed-val">
            <strong id="computed-raw-total">3.00</strong> <span style="font-size: 0.8rem; color: var(--text-dim);">/ 5.0</span>
          </div>
        </div>
        <div style="display: flex; gap: 0.75rem;">
          <button type="button" class="btn btn-secondary" onclick="closeModal()">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Evaluation</button>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
  function updateModalScore() {
    const f = parseFloat(document.getElementById('score-func').value) || 0;
    const q = parseFloat(document.getElementById('score-qual').value) || 0;
    const i = parseFloat(document.getElementById('score-innov').value) || 0;
    const total = f * 0.4 + q * 0.3 + i * 0.3;
    document.getElementById('computed-raw-total').textContent = total.toFixed(2);
  }

  function openScoringModal(id, title) {
    document.getElementById('modal-project-id').value = id;
    document.getElementById('modal-project-title').textContent = 'Evaluate: ' + title;
    updateModalScore();
    document.getElementById('scoring-modal').style.display = 'flex';
  }

  function closeModal() {
    document.getElementById('scoring-modal').style.display = 'none';
  }

  async function submitScore(e) {
    e.preventDefault();
    const projectId = document.getElementById('modal-project-id').value;
    const func = parseInt(document.getElementById('score-func').value, 10);
    const qual = parseInt(document.getElementById('score-qual').value, 10);
    const innov = parseInt(document.getElementById('score-innov').value, 10);
    const comment = document.getElementById('score-comment').value;

    const res = await fetch('/api/judge/scores', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        project_id: projectId,
        criteria: { functionality: func, quality: qual, innovation: innov },
        comment: comment
      })
    });

    if (res.ok) {
      window.location.reload();
    } else {
      const err = await res.json();
      alert('Error saving score: ' + (err.error || 'Unknown error'));
    }
  }
</script>
