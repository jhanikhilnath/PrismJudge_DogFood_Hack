<div class="page-hero">
  <div>
    <span class="card-track" style="font-size: 0.85rem;"><%= project.track_name || project.track_id %></span>
    <h1 class="page-title" style="margin-top: 0.5rem;"><%= project.title %></h1>
    <p class="page-subtitle">Submitted by <%= project.team_name || project.team_id %> on <%= new Date(project.submitted_at).toLocaleDateString() %></p>
  </div>
  <div style="display: flex; gap: 0.75rem;">
    <% if (project.repo_url) { %>
      <a href="<%= project.repo_url %>" target="_blank" class="btn btn-secondary">Source Code</a>
    <% } %>
    <a href="/certificates/<%= project.id %>" class="btn btn-secondary">View Certificate (T4)</a>
  </div>
</div>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; margin-bottom: 2rem;">
  <div>
    <div style="background: var(--bg-card); border: 1px solid var(--border); border-radius: 6px; padding: 1.5rem; margin-bottom: 1.5rem;">
      <h2 style="font-size: 1.1rem; font-family: var(--font-mono); margin-bottom: 0.75rem; color: var(--accent);">Project Summary</h2>
      <p style="font-size: 1.05rem; line-height: 1.7; color: var(--text-main);"><%= project.summary %></p>
    </div>

    <!-- Comments Section (T3) -->
    <div style="background: var(--bg-card); border: 1px solid var(--border); border-radius: 6px; padding: 1.5rem;">
      <h2 style="font-size: 1.1rem; font-family: var(--font-mono); margin-bottom: 1rem; color: var(--accent);">Community Discussion</h2>

      <form action="/api/comments/<%= project.id %>" method="POST" style="margin-bottom: 1.5rem;">
        <div class="form-group">
          <textarea name="content" rows="3" required class="form-textarea" placeholder="Leave constructive feedback or ask a question..."></textarea>
        </div>
        <button type="submit" class="btn btn-secondary btn-sm">Post Comment</button>
      </form>

      <div class="comments-list">
        <% if (comments && comments.length > 0) { %>
          <% comments.forEach(function(c) { %>
            <div style="border-top: 1px solid var(--border); padding: 0.85rem 0;">
              <div style="display: flex; justify-content: space-between; font-size: 0.8rem; font-family: var(--font-mono); color: var(--text-dim); margin-bottom: 0.25rem;">
                <span style="color: var(--text-muted);"><%= c.author_name %></span>
                <span><%= new Date(c.created_at).toLocaleDateString() %></span>
              </div>
              <p style="font-size: 0.95rem;"><%= c.content %></p>
            </div>
          <% }); %>
        <% } else { %>
          <p style="color: var(--text-dim); font-size: 0.9rem;">No comments yet. Be the first to share your thoughts!</p>
        <% } %>
      </div>
    </div>
  </div>

  <div>
    <div style="background: var(--bg-card); border: 1px solid var(--border); border-radius: 6px; padding: 1.5rem; margin-bottom: 1.5rem;">
      <h3 style="font-family: var(--font-mono); font-size: 0.9rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.75rem;">Team Members</h3>
      <ul style="list-style: none;">
        <% members.forEach(function(m) { %>
          <li style="padding: 0.4rem 0; font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-main); border-bottom: 1px solid rgba(255,255,255,0.04);">
            <%= m.email %>
          </li>
        <% }); %>
      </ul>
    </div>

    <!-- Community Vote Widget (T3) -->
    <div style="background: var(--bg-card); border: 1px solid var(--border); border-radius: 6px; padding: 1.5rem;">
      <h3 style="font-family: var(--font-mono); font-size: 0.9rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.75rem;">Community Vote (T3)</h3>
      <p style="font-size: 0.85rem; color: var(--text-dim); margin-bottom: 1rem;">Support this project in the community choice award.</p>
      <form action="/api/vote" method="POST">
        <input type="hidden" name="project_id" value="<%= project.id %>">
        <button type="submit" class="btn btn-primary" style="width: 100%;">★ Vote For Project</button>
      </form>
    </div>
  </div>
</div>
