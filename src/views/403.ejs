<div class="breadcrumb-nav" style="max-width: 720px; margin: 0 auto 1.5rem auto;">
  <a href="/" class="breadcrumb-link">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    Back to Portal Home
  </a>
</div>

<div class="restricted-container" style="max-width: 640px; margin: 2rem auto; background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-xl); padding: 3rem 2.5rem; text-align: center; box-shadow: var(--shadow-sm);">
  <div style="width: 56px; height: 56px; border-radius: 50%; background: #FEF2F2; border: 1px solid #FECDD3; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem auto; color: #DC2626;">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
    </svg>
  </div>

  <span class="badge-status badge-error" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700; margin-bottom: 0.75rem; display: inline-block;">
    HTTP 403 · Access Restricted
  </span>

  <h1 style="font-size: 1.5rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.75rem; letter-spacing: -0.02em;">
    Insufficient Role Permissions
  </h1>

  <p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.75rem;">
    <%= typeof message !== 'undefined' ? message : 'You do not have permission to view this section with your current account privileges.' %>
  </p>

  <div style="background: var(--bg-subtle); border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: 1rem 1.25rem; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 2rem; text-align: left;">
    <div style="font-weight: 600; color: var(--text-primary); margin-bottom: 0.25rem;">Active Session: <%= typeof user !== 'undefined' && user ? user.name : 'Authenticated User' %></div>
    <div>Your active role is <strong><%= typeof user !== 'undefined' && user ? user.role : 'unspecified' %></strong>. If you are participating as an evaluator or staff member, you can switch demo personas or sign in with elevated credentials.</div>
  </div>

  <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap;">
    <a href="/projects" class="btn btn-secondary">
      Browse Submissions
    </a>
    <a href="/api/auth/switch/organizer" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 0.4rem;">
      Switch to Organizer →
    </a>
    <a href="/api/auth/switch/judge_a" class="btn btn-secondary" style="display: inline-flex; align-items: center; gap: 0.4rem;">
      Switch to Judge A →
    </a>
    <a href="/login" class="btn btn-secondary">
      All Sign In Options
    </a>
  </div>
</div>
