  <!-- TAB 5: Rubric & Judging Policy -->
  <div id="section-rubric" class="settings-section" style="display: none;">
    <div class="card" style="margin-bottom: 1.5rem;">
      <div class="card-header" style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-light); display: flex; justify-content: space-between; align-items: center;">
        <div>
          <h3 style="font-size: 1.15rem; font-weight: 700; margin: 0;">Evaluation Rubric &amp; Bayesian Policies</h3>
          <p style="font-size: 0.85rem; color: var(--text-secondary); margin: 0.25rem 0 0 0;">
            Adjust criteria weightings, minimum assigned review quotas, and pairwise arena integration.
          </p>
        </div>
        <div id="rubric-sum-badge" class="status-pill status-completed" style="font-family: var(--font-mono); font-weight: 700;">
          WEIGHT TOTAL: 100%
        </div>
      </div>
      <div class="card-body" style="padding: 1.5rem;">
        <div style="background: var(--bg-subtle); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 0.85rem 1rem; margin-bottom: 1.5rem; font-size: 0.82rem;">
          <strong>Mathematical Invariant:</strong> The sum of all four rubric criteria weights must equal exactly 100% (1.0). The empirical Bayesian normalizer applies these weights to each juror's raw scores before computing the shrinkage Z-scores.
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem;">
          <!-- Functionality -->
          <div class="card" style="padding: 1rem; border: 1px solid var(--border);">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span style="font-weight: 600; font-size: 0.85rem;">Functionality</span>
              <span class="font-mono" id="disp-weight-func" style="font-weight: 700; color: var(--primary);">
                <%= Math.round((rubricWeights.functionality || 0.4) * 100) %>%
              </span>
            </div>
            <input 
              type="range" 
              name="weight_func" 
              id="slider-func" 
              min="0" 
              max="1" 
              step="0.05" 
              value="<%= rubricWeights.functionality || 0.4 %>"
              oninput="updateRubricWeights()"
              style="width: 100%; cursor: pointer;"
            >
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.35rem;">End-to-end functionality, offline boot speed, and UX.</div>
          </div>

          <!-- Code Quality -->
          <div class="card" style="padding: 1rem; border: 1px solid var(--border);">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span style="font-weight: 600; font-size: 0.85rem;">Code Quality &amp; Architecture</span>
              <span class="font-mono" id="disp-weight-qual" style="font-weight: 700; color: var(--primary);">
                <%= Math.round((rubricWeights.quality || 0.3) * 100) %>%
              </span>
            </div>
            <input 
              type="range" 
              name="weight_qual" 
              id="slider-qual" 
              min="0" 
              max="1" 
              step="0.05" 
              value="<%= rubricWeights.quality || 0.3 %>"
              oninput="updateRubricWeights()"
              style="width: 100%; cursor: pointer;"
            >
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.35rem;">Schema normalization, type safety, error boundaries.</div>
          </div>

          <!-- Innovation -->
          <div class="card" style="padding: 1rem; border: 1px solid var(--border);">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span style="font-weight: 600; font-size: 0.85rem;">Innovation</span>
              <span class="font-mono" id="disp-weight-inno" style="font-weight: 700; color: var(--primary);">
                <%= Math.round((rubricWeights.innovation || 0.2) * 100) %>%
              </span>
            </div>
            <input 
              type="range" 
              name="weight_inno" 
              id="slider-inno" 
              min="0" 
              max="1" 
              step="0.05" 
              value="<%= rubricWeights.innovation || 0.2 %>"
              oninput="updateRubricWeights()"
              style="width: 100%; cursor: pointer;"
            >
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.35rem;">Novelty of technical solution and originality.</div>
          </div>

          <!-- Impact -->
          <div class="card" style="padding: 1rem; border: 1px solid var(--border);">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span style="font-weight: 600; font-size: 0.85rem;">Impact &amp; Adoption</span>
              <span class="font-mono" id="disp-weight-imp" style="font-weight: 700; color: var(--primary);">
                <%= Math.round((rubricWeights.impact || 0.1) * 100) %>%
              </span>
            </div>
            <input 
              type="range" 
              name="weight_imp" 
              id="slider-imp" 
              min="0" 
              max="1" 
              step="0.05" 
              value="<%= rubricWeights.impact || 0.1 %>"
              oninput="updateRubricWeights()"
              style="width: 100%; cursor: pointer;"
            >
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.35rem;">Real-world utility and adoption potential.</div>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem;">
          <div>
            <label class="form-label" for="field-min-reviews" style="font-weight: 600; font-size: 0.85rem; display: block; margin-bottom: 0.35rem;">
              Minimum Reviews per Project Quota
            </label>
            <input 
              type="number" 
              id="field-min-reviews" 
              name="min_reviews_per_project" 
              class="form-input font-mono" 
              value="<%= event.min_reviews_per_project || 3 %>"
              min="1" 
              max="10"
              style="width: 120px;"
            >
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Projects below this quota trigger "Needs Review" status warnings.</div>
          </div>

          <div>
            <label class="form-label" style="font-weight: 600; font-size: 0.85rem; display: block; margin-bottom: 0.35rem;">
              Bradley-Terry Pairwise Showdowns
            </label>
            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.85rem;">
              <input type="hidden" name="pairwise_enabled" value="0">
              <input type="checkbox" name="pairwise_enabled" value="1" <%= event.pairwise_enabled !== 0 ? 'checked' : '' %>>
              <span>Enable side-by-side pairwise comparison arena at <code>/judge/pairwise</code></span>
            </label>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Minorization-Maximization solves latent project ratings mapped to Elo scale.</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- TAB 6: Submission & Voting Rules -->
  <div id="section-rules" class="settings-section" style="display: none;">
    <div class="card" style="margin-bottom: 1.5rem;">
      <div class="card-header" style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-light);">
        <h3 style="font-size: 1.15rem; font-weight: 700; margin: 0;">Submission Constraints &amp; Ballot Anti-Abuse Rules</h3>
        <p style="font-size: 0.85rem; color: var(--text-secondary); margin: 0.25rem 0 0 0;">
          Enforce team size boundaries, mandatory repo links, and PRD FR-205 anti-self-voting defenses.
        </p>
      </div>
      <div class="card-body" style="padding: 1.5rem;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 1.25rem;">
          <div>
            <label class="form-label" for="field-max-team-size" style="font-weight: 600; font-size: 0.85rem; display: block; margin-bottom: 0.35rem;">
              Maximum Team Size
            </label>
            <input 
              type="number" 
              id="field-max-team-size" 
              name="max_team_size" 
              class="form-input font-mono" 
              value="<%= event.max_team_size || 4 %>" 
              min="1" 
              max="12"
              style="width: 120px;"
            >
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Maximum number of registered hackers allowed per team roster.</div>
          </div>

          <div>
            <label class="form-label" for="field-voting-mode" style="font-weight: 600; font-size: 0.85rem; display: block; margin-bottom: 0.35rem;">
              Community Voting Mode (PRD FR-200)
            </label>
            <select id="field-voting-mode" name="voting_mode" class="form-select" style="max-width: 280px;">
              <option value="open" <%= event.voting_mode === 'open' ? 'selected' : '' %>>Open Public (Browser Fingerprinted)</option>
              <option value="email_gated" <%= event.voting_mode === 'email_gated' ? 'selected' : '' %>>Email Verified Only</option>
              <option value="authenticated" <%= event.voting_mode === 'authenticated' ? 'selected' : '' %>>Registered Participants Only</option>
            </select>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Determines eligibility criteria for casting community ballots.</div>
          </div>
        </div>

        <div style="border-top: 1px solid var(--border-light); padding-top: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem;">
          <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.85rem;">
            <input type="hidden" name="prevent_self_voting" value="0">
            <input type="checkbox" name="prevent_self_voting" value="1" <%= event.prevent_self_voting !== 0 ? 'checked' : '' %>>
            <span><strong>Anti-Self-Voting Barrier (PRD FR-205):</strong> Strictly reject votes cast by team members for their own project (HTTP 403)</span>
          </label>

          <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.85rem;">
            <input type="hidden" name="require_repo_url" value="0">
            <input type="checkbox" name="require_repo_url" value="1" <%= event.require_repo_url !== 0 ? 'checked' : '' %>>
            <span><strong>Require Source Code Repository:</strong> Mandatory public repository URL during submission</span>
          </label>

          <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.85rem;">
            <input type="hidden" name="require_demo_url" value="0">
            <input type="checkbox" name="require_demo_url" value="1" <%= event.require_demo_url === 1 ? 'checked' : '' %>>
            <span><strong>Require Live Demo / Artifact Link:</strong> Mandatory deployment URL during submission</span>
          </label>

          <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.85rem;">
            <input type="hidden" name="voting_results_published" value="0">
            <input type="checkbox" name="voting_results_published" value="1" <%= event.voting_results_published === 1 ? 'checked' : '' %>>
            <span><strong>Publish Community Choice Voting Standings:</strong> Reveal live community vote counts and rank badges to voters and participants</span>
          </label>

          <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.85rem;">
            <input type="hidden" name="results_published" value="0">
            <input type="checkbox" name="results_published" value="1" <%= event.results_published === 1 ? 'checked' : '' %>>
            <span><strong>Publish Official Results Portal (/results):</strong> Unveil podium grand champions, track awards, and full normalized leaderboard to all visitors</span>
          </label>
        </div>
      </div>
    </div>
  </div>

  <!-- TAB 7: Audit Ledger -->
  <div id="section-audit" class="settings-section" style="display: none;">
    <div class="card" style="margin-bottom: 1.5rem;">
      <div class="card-header" style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-light);">
        <h3 style="font-size: 1.15rem; font-weight: 700; margin: 0;">Configuration Mutation Audit Trail</h3>
        <p style="font-size: 0.85rem; color: var(--text-secondary); margin: 0.25rem 0 0 0;">
          Cryptographic, append-only history of all event and track configuration changes.
        </p>
      </div>
      <div class="card-body" style="padding: 0;">
        <div style="overflow-x: auto;">
          <table class="data-table" style="width: 100%; text-align: left; font-size: 0.82rem;">
            <thead>
              <tr style="background: var(--bg-subtle);">
                <th style="padding: 0.65rem 1rem; width: 140px;">Timestamp</th>
                <th style="padding: 0.65rem 1rem; width: 100px;">Actor</th>
                <th style="padding: 0.65rem 1rem; width: 180px;">Action</th>
                <th style="padding: 0.65rem 1rem;">Changes / Diff Payload</th>
              </tr>
            </thead>
            <tbody>
              <% if (!configAuditLogs || configAuditLogs.length === 0) { %>
                <tr>
                  <td colspan="4" style="padding: 2rem; text-align: center; color: var(--text-muted);">
                    No event configuration mutations recorded yet.
                  </td>
                </tr>
              <% } else { %>
                <% configAuditLogs.forEach(function(l) { %>
                  <tr>
                    <td style="padding: 0.65rem 1rem; font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-secondary);">
                      <%= l.created_at %>
                    </td>
                    <td style="padding: 0.65rem 1rem; font-family: var(--font-mono); font-weight: 600;">
                      <%= l.actor_id %> (<%= l.actor_role %>)
                    </td>
                    <td style="padding: 0.65rem 1rem;">
                      <span class="status-pill status-info font-mono" style="font-size: 0.7rem;"><%= l.action %></span>
                    </td>
                    <td style="padding: 0.65rem 1rem; font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-secondary); word-break: break-all;">
                      <%= typeof l.payload === 'string' ? l.payload : JSON.stringify(l.payload) %>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Action Bar -->
  <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1rem;">
    <a href="/organizer/dashboard" class="btn btn-secondary">Cancel</a>
