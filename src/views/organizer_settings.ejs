<div class="page-hero">
  <div class="hero-content">
    <div style="font-size: 0.8rem; font-family: var(--font-mono); color: var(--primary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.35rem;">
      <a href="/organizer/dashboard" style="color: inherit; text-decoration: none;">Operations Console</a> / Settings &amp; Configuration
    </div>
    <h1 class="page-title">Hackathon Configuration &amp; Rules</h1>
    <p class="page-subtitle">
      Manage event identity, submission deadlines, prize architecture, competitive tracks, and Bayesian evaluation policies with double-confirmation safety.
    </p>
  </div>
  <div class="hero-actions" style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
    <a href="/organizer/dashboard" class="btn btn-secondary">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      Return to Console
    </a>
    <button type="button" class="btn btn-primary" onclick="triggerSaveFlow()">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
      Save Configuration
    </button>
  </div>
</div>

<% if (saved) { %>
  <div class="alert alert-success" style="margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: var(--radius-lg); padding: 1rem 1.25rem; color: #065f46;">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
    <div>
      <strong>Configuration Updated Successfully!</strong> Event settings have been verified, applied to the database, and permanently recorded in the immutable audit ledger.
    </div>
  </div>
<% } %>

<% if (error) { %>
  <div class="alert alert-danger" style="margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem; background: #fef2f2; border: 1px solid #fecaca; border-radius: var(--radius-lg); padding: 1rem 1.25rem; color: #991b1b;">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <div>
      <strong>Update Rejected:</strong> <%= error %>
    </div>
  </div>
<% } %>

<!-- Section Navigation Tabs -->
<div class="filter-pills-scroll" style="margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
  <button type="button" class="btn btn-sm settings-tab-btn active" id="tab-btn-general" onclick="switchSettingsTab('general')">
    General &amp; Identity
  </button>
  <button type="button" class="btn btn-sm settings-tab-btn" id="tab-btn-timeline" onclick="switchSettingsTab('timeline')">
    Deadlines &amp; Timeline
  </button>
  <button type="button" class="btn btn-sm settings-tab-btn" id="tab-btn-prizes" onclick="switchSettingsTab('prizes')">
    Prizes &amp; Awards
  </button>
  <button type="button" class="btn btn-sm settings-tab-btn" id="tab-btn-tracks" onclick="switchSettingsTab('tracks')">
    Tracks Management (<%= tracks.length %>)
  </button>
  <button type="button" class="btn btn-sm settings-tab-btn" id="tab-btn-rubric" onclick="switchSettingsTab('rubric')">
    Judging &amp; Rubric
  </button>
  <button type="button" class="btn btn-sm settings-tab-btn" id="tab-btn-rules" onclick="switchSettingsTab('rules')">
    Submission &amp; Voting
  </button>
  <button type="button" class="btn btn-sm settings-tab-btn" id="tab-btn-audit" onclick="switchSettingsTab('audit')">
    Audit Ledger
  </button>
</div>

<!-- Main Settings Form -->
<form id="settings-form" method="POST" action="/organizer/settings" novalidate onsubmit="handleSettingsFormSubmit(event)">
  <input type="hidden" name="confirm_action" id="form-confirm-action" value="">
  <input type="hidden" name="prizes_json" id="form-prizes-json" value="">

  <!-- TAB 1: General Identity -->
  <div id="section-general" class="settings-section">
    <div class="card" style="margin-bottom: 1.5rem;">
      <div class="card-header" style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-light);">
        <h3 style="font-size: 1.15rem; font-weight: 700; margin: 0;">Event Identity &amp; Metadata</h3>
        <p style="font-size: 0.85rem; color: var(--text-secondary); margin: 0.25rem 0 0 0;">
          Public naming, tagline, and mission narrative displayed on the welcome portal.
        </p>
      </div>
      <div class="card-body" style="padding: 1.5rem;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
          <div>
            <label class="form-label" for="field-name" style="font-weight: 600; font-size: 0.85rem; display: block; margin-bottom: 0.35rem;">
              Hackathon Name *
            </label>
            <input 
              type="text" 
              id="field-name" 
              name="name" 
              class="form-input" 
              value="<%= event.name %>" 
              required
              style="width: 100%; font-family: var(--font-sans);"
            >
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Primary event title shown across banners and headers.</div>
          </div>
          <div>
            <label class="form-label" for="field-tagline" style="font-weight: 600; font-size: 0.85rem; display: block; margin-bottom: 0.35rem;">
              Event Tagline
            </label>
            <input 
              type="text" 
              id="field-tagline" 
              name="tagline" 
              class="form-input" 
              value="<%= event.tagline || 'Precision Hackathon Evaluation & Shrinkage Normalization Platform' %>"
              style="width: 100%;"
            >
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Short one-liner summarizing the hackathon focus.</div>
          </div>
        </div>

        <div>
          <label class="form-label" for="field-description" style="font-weight: 600; font-size: 0.85rem; display: block; margin-bottom: 0.35rem;">
            Event Mission &amp; Overview
          </label>
          <textarea 
            id="field-description" 
            name="description" 
            class="form-input" 
            rows="4" 
            style="width: 100%; resize: vertical;"
          ><%= event.description || 'Welcome to PrismJudge 2026. Innovators, engineers, and researchers compete across cutting-edge tracks with mathematical scoring rigor.' %></textarea>
          <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Detailed event narrative, rules overview, and welcome statement.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- TAB 2: Timeline & Deadlines -->
  <div id="section-timeline" class="settings-section" style="display: none;">
    <div class="card" style="margin-bottom: 1.5rem;">
      <div class="card-header" style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-light); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
        <div>
          <h3 style="font-size: 1.15rem; font-weight: 700; margin: 0;">Schedule, Milestones &amp; Gating Deadlines</h3>
          <p style="font-size: 0.85rem; color: var(--text-secondary); margin: 0.25rem 0 0 0;">
            Controls phase transitions, project submission guards, judging window, and community ballot sealing.
          </p>
        </div>
        <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
          <span class="status-pill status-warning" style="font-size: 0.75rem; font-weight: 600;">HIGH-IMPACT SETTING</span>
        </div>
      </div>
      <div class="card-body" style="padding: 1.5rem;">
        <!-- Global Toolbar for Pickers -->
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; background: var(--bg-subtle, #f8fafc); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 0.85rem 1rem; margin-bottom: 1.5rem;">
          <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
            <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-primary);">Timezone Display:</span>
            <div class="dt-tz-pill-group">
              <button type="button" class="dt-tz-pill global-tz-btn active" data-tz="utc" onclick="setAllPickersTz('utc')">🌐 All in UTC</button>
              <button type="button" class="dt-tz-pill global-tz-btn" data-tz="local" onclick="setAllPickersTz('local')">📍 All in Local Time</button>
            </div>
            <span id="detected-tz-label" style="font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono); margin-left: 0.25rem;"></span>
          </div>

          <div style="display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap;">
            <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600;">Bulk Adjust:</span>
            <button type="button" class="dt-preset-btn" onclick="bulkAdjustAllMilestones(24)" title="Add 24 hours to all 7 timeline milestones">+24h to All</button>
            <button type="button" class="dt-preset-btn" onclick="bulkAdjustAllMilestones(168)" title="Add 7 days to all 7 timeline milestones">+7d to All</button>
          </div>
        </div>

        <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: var(--radius-md); padding: 0.85rem 1rem; margin-bottom: 1.5rem; font-size: 0.82rem; color: #92400e;">
          <strong>Security Notice:</strong> The <code>submissions_close</code> timestamp is strictly enforced by Fastify pre-handlers. Any submission attempt after this deadline will be rejected with HTTP 403 Forbidden.
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.25rem;">
          <!-- 1. Submissions Open -->
          <div class="dt-picker-card" data-field-id="field-submissions-open">
            <div class="dt-picker-header">
              <div class="dt-picker-title-col">
                <div class="dt-picker-title">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  <span>Submissions Open</span>
                </div>
                <div class="dt-picker-desc">Participants may begin publishing submission entries</div>
              </div>
              <div class="dt-tz-pill-group">
                <button type="button" class="dt-tz-pill active" data-tz="utc" onclick="setPickerTz('field-submissions-open', 'utc')">UTC</button>
                <button type="button" class="dt-tz-pill" data-tz="local" onclick="setPickerTz('field-submissions-open', 'local')">Local</button>
              </div>
            </div>

            <div class="dt-input-wrapper">
              <input 
                type="datetime-local" 
                class="form-input dt-native-input" 
                step="60"
                onchange="onNativePickerChange('field-submissions-open')"
                title="Select date and time from calendar"
              >
              <button type="button" class="dt-calendar-trigger" title="Open Calendar" onclick="openPickerFor('field-submissions-open')">📅</button>
            </div>

            <div class="dt-presets-row">
              <span style="font-size: 0.68rem; color: var(--text-muted); font-weight: 600;">Presets:</span>
              <button type="button" class="dt-preset-btn" onclick="adjustPickerTime('field-submissions-open', 1, 'hour')">+1h</button>
              <button type="button" class="dt-preset-btn" onclick="adjustPickerTime('field-submissions-open', 24, 'hour')">+24h</button>
              <button type="button" class="dt-preset-btn" onclick="adjustPickerTime('field-submissions-open', 7, 'day')">+7d</button>
              <button type="button" class="dt-preset-btn" onclick="adjustPickerTime('field-submissions-open', 0, 'endOfDay')">23:59</button>
              <button type="button" class="dt-preset-btn" onclick="adjustPickerTime('field-submissions-open', 0, 'now')">Now</button>
            </div>

            <div class="dt-preview-panel">
              <div class="dt-preview-item">
                <span class="dt-preview-label">🌐 UTC:</span>
                <span class="dt-preview-val dt-preview-utc">Loading...</span>
              </div>
              <div class="dt-preview-item">
                <span class="dt-preview-label">📍 <span class="dt-preview-local-name">Local</span>:</span>
                <span class="dt-preview-val dt-preview-local">Loading...</span>
              </div>
              <div class="dt-preview-item">
                <span class="dt-preview-label">⏱️ Status:</span>
                <span class="dt-preview-val dt-preview-relative">...</span>
              </div>
            </div>

            <div class="dt-raw-iso-details">
              <button type="button" class="dt-raw-iso-toggle" onclick="toggleRawIso('field-submissions-open-iso-wrapper')">
                ⚙️ Advanced: Raw ISO 8601 String
              </button>
              <div id="field-submissions-open-iso-wrapper" style="display: none; margin-top: 0.4rem;">
                <input 
                  type="text" 
                  id="field-submissions-open" 
                  name="submissions_open" 
                  class="form-input font-mono dt-canonical-input" 
                  value="<%= event.submissions_open || '2026-02-25T00:00:00Z' %>"
                  oninput="onCanonicalInputChange('field-submissions-open')"
                  style="width: 100%; font-size: 0.8rem;"
                >
                <div style="font-size: 0.7rem; color: var(--text-muted); margin-top: 0.2rem;">
                  Exact ISO timestamp sent to the server. Updates automatically with the picker.
                </div>
              </div>
            </div>
          </div>

          <!-- 2. Submissions Deadline (CRITICAL) -->
          <div class="dt-picker-card is-critical" data-field-id="field-submissions-close">
            <div class="dt-picker-header">
              <div class="dt-picker-title-col">
                <div class="dt-picker-title" style="color: #b45309;">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                  <span>Submissions Deadline *</span>
                  <span class="status-pill status-warning" style="font-size: 0.65rem; padding: 0.1rem 0.35rem; font-weight: 700;">ENFORCED</span>
                </div>
                <div class="dt-picker-desc">Hard cutoff: submissions refused after this instant (HTTP 403)</div>
              </div>
              <div class="dt-tz-pill-group">
                <button type="button" class="dt-tz-pill active" data-tz="utc" onclick="setPickerTz('field-submissions-close', 'utc')">UTC</button>
                <button type="button" class="dt-tz-pill" data-tz="local" onclick="setPickerTz('field-submissions-close', 'local')">Local</button>
              </div>
            </div>

            <div class="dt-input-wrapper">
              <input 
                type="datetime-local" 
                class="form-input dt-native-input" 
                step="60"
                style="border-color: #f59e0b;"
                onchange="onNativePickerChange('field-submissions-close')"
                title="Select date and time from calendar"
              >
              <button type="button" class="dt-calendar-trigger" title="Open Calendar" onclick="openPickerFor('field-submissions-close')">📅</button>
            </div>

            <div class="dt-presets-row">
              <span style="font-size: 0.68rem; color: var(--text-muted); font-weight: 600;">Presets:</span>
              <button type="button" class="dt-preset-btn" onclick="adjustPickerTime('field-submissions-close', 1, 'hour')">+1h</button>
              <button type="button" class="dt-preset-btn" onclick="adjustPickerTime('field-submissions-close', 24, 'hour')">+24h</button>
              <button type="button" class="dt-preset-btn" onclick="adjustPickerTime('field-submissions-close', 48, 'hour')">+48h</button>
              <button type="button" class="dt-preset-btn" onclick="adjustPickerTime('field-submissions-close', 7, 'day')">+7d</button>
              <button type="button" class="dt-preset-btn" onclick="adjustPickerTime('field-submissions-close', 0, 'endOfDay')">23:59</button>
              <button type="button" class="dt-preset-btn" onclick="adjustPickerTime('field-submissions-close', 0, 'now')">Now</button>
            </div>

            <div class="dt-preview-panel" style="background: #fffbeb; border-color: #fde68a;">
              <div class="dt-preview-item">
                <span class="dt-preview-label">🌐 UTC:</span>
                <span class="dt-preview-val dt-preview-utc">Loading...</span>
              </div>
              <div class="dt-preview-item">
                <span class="dt-preview-label">📍 <span class="dt-preview-local-name">Local</span>:</span>
                <span class="dt-preview-val dt-preview-local">Loading...</span>
              </div>
              <div class="dt-preview-item">
                <span class="dt-preview-label">⏱️ Status:</span>
                <span class="dt-preview-val dt-preview-relative">...</span>
              </div>
            </div>

            <div class="dt-raw-iso-details">
              <button type="button" class="dt-raw-iso-toggle" onclick="toggleRawIso('field-submissions-close-iso-wrapper')">
                ⚙️ Advanced: Raw ISO 8601 String
              </button>
              <div id="field-submissions-close-iso-wrapper" style="display: none; margin-top: 0.4rem;">
                <input 
                  type="text" 
                  id="field-submissions-close" 
                  name="submissions_close" 
                  class="form-input font-mono dt-canonical-input" 
                  value="<%= event.submissions_close %>"
                  required
                  oninput="onCanonicalInputChange('field-submissions-close')"
                  style="width: 100%; font-size: 0.8rem; border-color: #f59e0b;"
                >
                <div style="font-size: 0.7rem; color: var(--text-muted); margin-top: 0.2rem;">
                  Exact ISO timestamp sent to the server. Updates automatically with the picker.
                </div>
              </div>
            </div>
          </div>

          <!-- 3. Judging Starts -->
          <div class="dt-picker-card" data-field-id="field-judging-open">
            <div class="dt-picker-header">
              <div class="dt-picker-title-col">
                <div class="dt-picker-title">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  <span>Judging Starts</span>
                </div>
                <div class="dt-picker-desc">Official evaluator scoring begins across rubric queue</div>
              </div>
              <div class="dt-tz-pill-group">
                <button type="button" class="dt-tz-pill active" data-tz="utc" onclick="setPickerTz('field-judging-open', 'utc')">UTC</button>
                <button type="button" class="dt-tz-pill" data-tz="local" onclick="setPickerTz('field-judging-open', 'local')">Local</button>
              </div>
            </div>

            <div class="dt-input-wrapper">
              <input 
                type="datetime-local" 
                class="form-input dt-native-input" 
                step="60"
                onchange="onNativePickerChange('field-judging-open')"
                title="Select date and time from calendar"
              >
              <button type="button" class="dt-calendar-trigger" title="Open Calendar" onclick="openPickerFor('field-judging-open')">📅</button>
            </div>

            <div class="dt-presets-row">
              <span style="font-size: 0.68rem; color: var(--text-muted); font-weight: 600;">Presets:</span>
              <button type="button" class="dt-preset-btn" onclick="adjustPickerTime('field-judging-open', 1, 'hour')">+1h</button>
              <button type="button" class="dt-preset-btn" onclick="adjustPickerTime('field-judging-open', 24, 'hour')">+24h</button>
              <button type="button" class="dt-preset-btn" onclick="adjustPickerTime('field-judging-open', 7, 'day')">+7d</button>
              <button type="button" class="dt-preset-btn" onclick="adjustPickerTime('field-judging-open', 0, 'endOfDay')">23:59</button>
              <button type="button" class="dt-preset-btn" onclick="adjustPickerTime('field-judging-open', 0, 'now')">Now</button>
            </div>

            <div class="dt-preview-panel">
              <div class="dt-preview-item">
                <span class="dt-preview-label">🌐 UTC:</span>
                <span class="dt-preview-val dt-preview-utc">Loading...</span>
              </div>
              <div class="dt-preview-item">
                <span class="dt-preview-label">📍 <span class="dt-preview-local-name">Local</span>:</span>
                <span class="dt-preview-val dt-preview-local">Loading...</span>
              </div>
              <div class="dt-preview-item">
                <span class="dt-preview-label">⏱️ Status:</span>
                <span class="dt-preview-val dt-preview-relative">...</span>
              </div>
            </div>

            <div class="dt-raw-iso-details">
              <button type="button" class="dt-raw-iso-toggle" onclick="toggleRawIso('field-judging-open-iso-wrapper')">
                ⚙️ Advanced: Raw ISO 8601 String
              </button>
              <div id="field-judging-open-iso-wrapper" style="display: none; margin-top: 0.4rem;">
                <input 
                  type="text" 
                  id="field-judging-open" 
                  name="judging_open" 
                  class="form-input font-mono dt-canonical-input" 
                  value="<%= event.judging_open || '2026-03-01T18:00:00Z' %>"
                  oninput="onCanonicalInputChange('field-judging-open')"
                  style="width: 100%; font-size: 0.8rem;"
                >
                <div style="font-size: 0.7rem; color: var(--text-muted); margin-top: 0.2rem;">
                  Exact ISO timestamp sent to the server. Updates automatically with the picker.
                </div>
              </div>
            </div>
          </div>

          <!-- 4. Judging Deadline -->
          <div class="dt-picker-card" data-field-id="field-judging-close">
            <div class="dt-picker-header">
              <div class="dt-picker-title-col">
                <div class="dt-picker-title">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  <span>Judging Deadline</span>
                </div>
                <div class="dt-picker-desc">Juror evaluation window locks and final rankings freeze</div>
              </div>
              <div class="dt-tz-pill-group">
                <button type="button" class="dt-tz-pill active" data-tz="utc" onclick="setPickerTz('field-judging-close', 'utc')">UTC</button>
                <button type="button" class="dt-tz-pill" data-tz="local" onclick="setPickerTz('field-judging-close', 'local')">Local</button>
              </div>
            </div>

            <div class="dt-input-wrapper">
              <input 
                type="datetime-local" 
                class="form-input dt-native-input" 
                step="60"
                onchange="onNativePickerChange('field-judging-close')"
                title="Select date and time from calendar"
              >
              <button type="button" class="dt-calendar-trigger" title="Open Calendar" onclick="openPickerFor('field-judging-close')">📅</button>
            </div>

            <div class="dt-presets-row">
              <span style="font-size: 0.68rem; color: var(--text-muted); font-weight: 600;">Presets:</span>
              <button type="button" class="dt-preset-btn" onclick="adjustPickerTime('field-judging-close', 1, 'hour')">+1h</button>
              <button type="button" class="dt-preset-btn" onclick="adjustPickerTime('field-judging-close', 24, 'hour')">+24h</button>
              <button type="button" class="dt-preset-btn" onclick="adjustPickerTime('field-judging-close', 7, 'day')">+7d</button>
              <button type="button" class="dt-preset-btn" onclick="adjustPickerTime('field-judging-close', 0, 'endOfDay')">23:59</button>
              <button type="button" class="dt-preset-btn" onclick="adjustPickerTime('field-judging-close', 0, 'now')">Now</button>
            </div>

            <div class="dt-preview-panel">
              <div class="dt-preview-item">
                <span class="dt-preview-label">🌐 UTC:</span>
                <span class="dt-preview-val dt-preview-utc">Loading...</span>
              </div>
              <div class="dt-preview-item">
