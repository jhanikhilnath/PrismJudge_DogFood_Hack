<script>
  function serializePrizes() {
    const rows = document.querySelectorAll('.prize-row');
    const list = [];
    rows.forEach((r, idx) => {
      const name = r.querySelector('.prz-name')?.value?.trim();
      const amount = r.querySelector('.prz-amount')?.value?.trim();
      const desc = r.querySelector('.prz-desc')?.value?.trim();
      if (name) {
        list.push({ id: 'prz_' + (idx + 1).toString().padStart(2, '0'), name, amount: amount || '$0', description: desc || '' });
      }
    });
    return JSON.stringify(list);
  }

  function editTrackFromBtn(btn) {
    const id = btn.getAttribute('data-track-id') || '';
    const name = btn.getAttribute('data-track-name') || '';
    const desc = btn.getAttribute('data-track-desc') || '';
    const prize = btn.getAttribute('data-track-prize') || '$500';
    editTrack(id, name, desc, prize);
  }

  function confirmDeleteTrackFromBtn(btn) {
    const id = btn.getAttribute('data-track-id') || '';
    const name = btn.getAttribute('data-track-name') || '';
    confirmDeleteTrack(id, name);
  }

  function captureCurrentFormValues() {
    const f = parseFloat(document.getElementById('slider-func')?.value) || 0;
    const q = parseFloat(document.getElementById('slider-qual')?.value) || 0;
    const i = parseFloat(document.getElementById('slider-inno')?.value) || 0;
    const m = parseFloat(document.getElementById('slider-imp')?.value) || 0;
    return {
      name: document.getElementById('field-name')?.value?.trim() || '',
      tagline: document.getElementById('field-tagline')?.value?.trim() || '',
      description: document.getElementById('field-description')?.value?.trim() || '',
      submissions_open: document.getElementById('field-submissions-open')?.value?.trim() || '',
      submissions_close: document.getElementById('field-submissions-close')?.value?.trim() || '',
      judging_open: document.getElementById('field-judging-open')?.value?.trim() || '',
      judging_close: document.getElementById('field-judging-close')?.value?.trim() || '',
      voting_open: document.getElementById('field-voting-open')?.value?.trim() || '',
      voting_close: document.getElementById('field-voting-close')?.value?.trim() || '',
      results_announced_at: document.getElementById('field-results-announced')?.value?.trim() || '',
      prize_pool: document.getElementById('field-prize-pool')?.value?.trim() || '',
      prizes_json: typeof serializePrizes === 'function' ? serializePrizes() : '',
      weight_func: f,
      weight_qual: q,
      weight_inno: i,
      weight_imp: m,
      min_reviews_per_project: parseInt(document.getElementById('field-min-reviews')?.value, 10) || 3,
      max_team_size: parseInt(document.getElementById('field-max-team-size')?.value, 10) || 4,
      voting_mode: document.getElementById('field-voting-mode')?.value || 'open',
      prevent_self_voting: document.querySelector('input[name="prevent_self_voting"]')?.checked ? 1 : 0,
      require_repo_url: document.querySelector('input[name="require_repo_url"]')?.checked ? 1 : 0,
      require_demo_url: document.querySelector('input[name="require_demo_url"]')?.checked ? 1 : 0,
      pairwise_enabled: document.querySelector('input[name="pairwise_enabled"]')?.checked ? 1 : 0,
      voting_results_published: document.querySelector('input[name="voting_results_published"]')?.checked ? 1 : 0,
      results_published: document.querySelector('input[name="results_published"]')?.checked ? 1 : 0
    };
  }

  // Initial Snapshot captured dynamically on load
  let INITIAL_CONFIG = {};
  let pendingDeleteTrackId = null;

  // =========================================================================
  // Enhanced Interactive Date & Time Picker System
  // =========================================================================
  const USER_TIMEZONE = Intl.DateTimeFormat().resolvedOptions().timeZone || 'Local';
  const PICKER_TIMEZONES = {}; // fieldId -> 'utc' | 'local'

  function padZero(n) {
    return String(n).padStart(2, '0');
  }

  function toDatetimeLocalString(date, mode) {
    if (!date || isNaN(date.getTime())) return '';
    if (mode === 'utc') {
      return `${date.getUTCFullYear()}-${padZero(date.getUTCMonth() + 1)}-${padZero(date.getUTCDate())}T${padZero(date.getUTCHours())}:${padZero(date.getUTCMinutes())}`;
    } else {
      return `${date.getFullYear()}-${padZero(date.getMonth() + 1)}-${padZero(date.getDate())}T${padZero(date.getHours())}:${padZero(date.getMinutes())}`;
    }
  }

  function parseDatetimeLocalString(str, mode) {
    if (!str) return null;
    const parts = str.split('T');
    if (parts.length !== 2) return null;
    const [y, m, d] = parts[0].split('-').map(Number);
    const [h, min] = parts[1].split(':').map(Number);
    if ([y, m, d, h, min].some(isNaN)) return null;
    if (mode === 'utc') {
      return new Date(Date.UTC(y, m - 1, d, h, min, 0));
    } else {
      return new Date(y, m - 1, d, h, min, 0);
    }
  }

  function formatUtcFriendly(d) {
    if (!d || isNaN(d.getTime())) return '(Not set)';
    return d.toLocaleDateString('en-US', {
      timeZone: 'UTC',
      weekday: 'short',
      month: 'short',
      day: 'numeric',
      year: 'numeric'
    }) + ' at ' + d.toLocaleTimeString('en-US', {
      timeZone: 'UTC',
      hour: 'numeric',
      minute: '2-digit',
      timeZoneName: 'short'
    });
  }

  function formatLocalFriendly(d) {
    if (!d || isNaN(d.getTime())) return '(Not set)';
    return d.toLocaleDateString(undefined, {
      weekday: 'short',
      month: 'short',
      day: 'numeric',
      year: 'numeric'
    }) + ' at ' + d.toLocaleTimeString(undefined, {
      hour: 'numeric',
      minute: '2-digit'
    }) + ' (' + USER_TIMEZONE + ')';
  }

  function formatRelativeStatus(d) {
    if (!d || isNaN(d.getTime())) return '';
    const diff = d.getTime() - Date.now();
    const absDiff = Math.abs(diff);
    const days = Math.floor(absDiff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((absDiff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((absDiff % (1000 * 60 * 60)) / (1000 * 60));
    
    let timeStr = '';
    if (days > 0) timeStr = `${days}d ${hours}h`;
    else if (hours > 0) timeStr = `${hours}h ${minutes}m`;
    else timeStr = `${minutes}m`;

    if (diff < 0) {
      return `<span style="color: #dc2626; font-weight: 600;">⚠️ Passed (${timeStr} ago)</span>`;
    } else {
      return `<span style="color: #059669; font-weight: 600;">✅ Active (in ${timeStr})</span>`;
    }
  }

  function updatePickerCardDisplay(fieldId) {
    const card = document.querySelector(`.dt-picker-card[data-field-id="${fieldId}"]`);
    if (!card) return;

    const canonicalInput = document.getElementById(fieldId);
    const nativeInput = card.querySelector('.dt-native-input');
    const mode = PICKER_TIMEZONES[fieldId] || 'utc';

    const d = canonicalInput?.value ? new Date(canonicalInput.value) : null;
    if (d && !isNaN(d.getTime())) {
      if (nativeInput) {
        nativeInput.value = toDatetimeLocalString(d, mode);
      }
      const utcEl = card.querySelector('.dt-preview-utc');
      if (utcEl) utcEl.textContent = formatUtcFriendly(d);

      const localEl = card.querySelector('.dt-preview-local');
      if (localEl) localEl.textContent = formatLocalFriendly(d);

      const relEl = card.querySelector('.dt-preview-relative');
      if (relEl) relEl.innerHTML = formatRelativeStatus(d);
    } else {
      if (nativeInput) nativeInput.value = '';
      const utcEl = card.querySelector('.dt-preview-utc');
      if (utcEl) utcEl.textContent = '(Not set)';
      const localEl = card.querySelector('.dt-preview-local');
      if (localEl) localEl.textContent = '(Not set)';
      const relEl = card.querySelector('.dt-preview-relative');
      if (relEl) relEl.textContent = '(Not set)';
    }

    // Update active pill
    card.querySelectorAll('.dt-tz-pill').forEach(btn => {
      if (btn.getAttribute('data-tz') === mode) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });

    const localNameEl = card.querySelector('.dt-preview-local-name');
    if (localNameEl) localNameEl.textContent = USER_TIMEZONE;
  }

  function initAllDateTimePickers() {
    document.querySelectorAll('.dt-picker-card').forEach(card => {
      const fieldId = card.getAttribute('data-field-id');
      if (!fieldId) return;
      if (!PICKER_TIMEZONES[fieldId]) {
        PICKER_TIMEZONES[fieldId] = 'utc';
      }
      updatePickerCardDisplay(fieldId);
    });

    const tzLabel = document.getElementById('detected-tz-label');
    if (tzLabel) {
      tzLabel.textContent = `(Detected: ${USER_TIMEZONE})`;
    }
  }

  function setPickerTz(fieldId, tz) {
    PICKER_TIMEZONES[fieldId] = tz;
    updatePickerCardDisplay(fieldId);
  }

  function setAllPickersTz(tz) {
    document.querySelectorAll('.dt-picker-card').forEach(card => {
      const fieldId = card.getAttribute('data-field-id');
      if (fieldId) {
        PICKER_TIMEZONES[fieldId] = tz;
        updatePickerCardDisplay(fieldId);
      }
    });
    document.querySelectorAll('.global-tz-btn').forEach(btn => {
      if (btn.getAttribute('data-tz') === tz) btn.classList.add('active');
      else btn.classList.remove('active');
    });
  }

  function onNativePickerChange(fieldId) {
    const card = document.querySelector(`.dt-picker-card[data-field-id="${fieldId}"]`);
    if (!card) return;
    const nativeInput = card.querySelector('.dt-native-input');
    const canonicalInput = document.getElementById(fieldId);
    if (!nativeInput || !canonicalInput) return;

    const mode = PICKER_TIMEZONES[fieldId] || 'utc';
    const parsed = parseDatetimeLocalString(nativeInput.value, mode);
    if (parsed && !isNaN(parsed.getTime())) {
      canonicalInput.value = parsed.toISOString();
      updatePickerCardDisplay(fieldId);
    }
  }

  function onCanonicalInputChange(fieldId) {
    updatePickerCardDisplay(fieldId);
  }

  function openPickerFor(fieldId) {
    const card = document.querySelector(`.dt-picker-card[data-field-id="${fieldId}"]`);
    if (!card) return;
    const nativeInput = card.querySelector('.dt-native-input');
    if (!nativeInput) return;
    if (typeof nativeInput.showPicker === 'function') {
      try {
        nativeInput.showPicker();
      } catch (err) {
        nativeInput.focus();
      }
    } else {
      nativeInput.focus();
    }
  }

  function adjustPickerTime(fieldId, amount, unit) {
    const canonicalInput = document.getElementById(fieldId);
    if (!canonicalInput) return;

    let base = canonicalInput.value ? new Date(canonicalInput.value) : new Date();
    if (isNaN(base.getTime())) base = new Date();

    const mode = PICKER_TIMEZONES[fieldId] || 'utc';

    if (unit === 'now') {
      base = new Date();
    } else if (unit === 'endOfDay') {
      if (mode === 'utc') {
        base = new Date(Date.UTC(base.getUTCFullYear(), base.getUTCMonth(), base.getUTCDate(), 23, 59, 0));
      } else {
        base = new Date(base.getFullYear(), base.getMonth(), base.getDate(), 23, 59, 0);
      }
    } else if (unit === 'hour') {
      base = new Date(base.getTime() + amount * 3600 * 1000);
    } else if (unit === 'day') {
      base = new Date(base.getTime() + amount * 24 * 3600 * 1000);
    }

    canonicalInput.value = base.toISOString();
    updatePickerCardDisplay(fieldId);
  }

  function bulkAdjustAllMilestones(hours) {
    document.querySelectorAll('.dt-picker-card').forEach(card => {
      const fieldId = card.getAttribute('data-field-id');
      if (fieldId) {
        adjustPickerTime(fieldId, hours, 'hour');
      }
    });
    if (window.showToast) {
      window.showToast(`Adjusted all timeline milestones by ${hours > 0 ? '+' : ''}${hours} hours.`, 'success');
    }
  }

  function toggleRawIso(wrapperId) {
    const el = document.getElementById(wrapperId);
    if (el) {
      el.style.display = el.style.display === 'none' ? 'block' : 'none';
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    updateRubricWeights();
    initAllDateTimePickers();
    INITIAL_CONFIG = captureCurrentFormValues();
    const urlParams = new URLSearchParams(window.location.search);
    const initialTab = urlParams.get('tab') || '<%- tab || "general" %>';
    switchSettingsTab(initialTab);
  });

  function switchSettingsTab(tabName) {
    document.querySelectorAll('.settings-section').forEach(el => el.style.display = 'none');
    document.querySelectorAll('.settings-tab-btn').forEach(el => el.classList.remove('active'));
    
    const sec = document.getElementById('section-' + tabName);
    if (sec) sec.style.display = 'block';
    
    const btn = document.getElementById('tab-btn-' + tabName);
    if (btn) btn.classList.add('active');
  }

  function updateRubricWeights() {
    const f = parseFloat(document.getElementById('slider-func')?.value) || 0;
    const q = parseFloat(document.getElementById('slider-qual')?.value) || 0;
    const i = parseFloat(document.getElementById('slider-inno')?.value) || 0;
    const m = parseFloat(document.getElementById('slider-imp')?.value) || 0;

    const dispFunc = document.getElementById('disp-weight-func');
    const dispQual = document.getElementById('disp-weight-qual');
    const dispInno = document.getElementById('disp-weight-inno');
    const dispImp = document.getElementById('disp-weight-imp');

    if (dispFunc) dispFunc.textContent = Math.round(f * 100) + '%';
    if (dispQual) dispQual.textContent = Math.round(q * 100) + '%';
    if (dispInno) dispInno.textContent = Math.round(i * 100) + '%';
    if (dispImp) dispImp.textContent = Math.round(m * 100) + '%';

    const sum = Math.round((f + q + i + m) * 100);
    const badge = document.getElementById('rubric-sum-badge');
    if (badge) {
      badge.textContent = 'WEIGHT TOTAL: ' + sum + '%';
      if (sum === 100) {
        badge.className = 'status-pill status-completed';
      } else {
        badge.className = 'status-pill status-warning';
      }
    }
  }

  function addPrizeTierRow() {
    const tbody = document.getElementById('prizes-table-body');
    const tr = document.createElement('tr');
    tr.className = 'prize-row';
    tr.innerHTML = `
      <td style="padding: 0.5rem 0.75rem;">
        <input type="text" class="form-input prz-name" value="Special Category Award" style="width: 100%; font-size: 0.82rem; padding: 0.35rem 0.5rem;">
      </td>
      <td style="padding: 0.5rem 0.75rem;">
        <input type="text" class="form-input prz-amount font-mono" value="$1,000" style="width: 100%; font-size: 0.82rem; padding: 0.35rem 0.5rem; font-weight: 600; color: #059669;">
      </td>
      <td style="padding: 0.5rem 0.75rem;">
        <input type="text" class="form-input prz-desc" value="Excellence in execution" style="width: 100%; font-size: 0.82rem; padding: 0.35rem 0.5rem;">
      </td>
      <td style="padding: 0.5rem 0.75rem; text-align: right;">
        <button type="button" class="btn btn-secondary btn-sm" onclick="removePrizeRow(this)" style="color: #dc2626; padding: 0.25rem 0.5rem;">
          Remove
        </button>
      </td>
    `;
    tbody.appendChild(tr);
  }

  function removePrizeRow(btn) {
    const tr = btn.closest('tr');
    if (tr) tr.remove();
  }

  function triggerSaveFlow() {
    // 1. Validate rubric sum
    const f = parseFloat(document.getElementById('slider-func')?.value) || 0;
    const q = parseFloat(document.getElementById('slider-qual')?.value) || 0;
    const i = parseFloat(document.getElementById('slider-inno')?.value) || 0;
    const m = parseFloat(document.getElementById('slider-imp')?.value) || 0;
    const sum = Math.round((f + q + i + m) * 100);
    if (sum !== 100) {
      if (window.showToast) {
        window.showToast('Rubric criteria weights must sum to exactly 100% (currently ' + sum + '%).', 'error');
      } else {
        alert('Rubric criteria weights must sum to exactly 100% (currently ' + sum + '%). Please adjust sliders before saving.');
      }
      switchSettingsTab('rubric');
      return;
    }

    // 2. Collect current form values
    const currentValues = captureCurrentFormValues();

    // 3. Compute diff
    const diffs = [];
    const labelMap = {
      name: 'Event Name',
      tagline: 'Tagline',
      description: 'Overview',
      submissions_open: 'Submissions Open',
      submissions_close: 'Submissions Deadline',
      judging_open: 'Judging Starts',
      judging_close: 'Judging Deadline',
      voting_open: 'Voting Starts',
      voting_close: 'Voting Deadline',
      results_announced_at: 'Results Announcement',
      prize_pool: 'Prize Pool Headline',
      prizes_json: 'Prize Tiers & Categories',
      weight_func: 'Functionality Weight',
      weight_qual: 'Quality Weight',
      weight_inno: 'Innovation Weight',
      weight_imp: 'Impact Weight',
      min_reviews_per_project: 'Min Reviews Quota',
      max_team_size: 'Max Team Size',
      voting_mode: 'Voting Mode',
      prevent_self_voting: 'Anti-Self-Voting Barrier',
      require_repo_url: 'Require Repo URL',
      require_demo_url: 'Require Demo URL',
      pairwise_enabled: 'Pairwise Showdowns',
      voting_results_published: 'Publish Community Choice Standings',
      results_published: 'Publish Results Page (/results)'
    };

    let hasCriticalChange = false;
    let criticalWarning = '';

    const dateKeys = [
      'submissions_open',
      'submissions_close',
      'judging_open',
      'judging_close',
      'voting_open',
      'voting_close',
      'results_announced_at'
    ];

    for (const key of Object.keys(currentValues)) {
      let isDiff = String(currentValues[key]) !== String(INITIAL_CONFIG[key]);

      // Normalize date comparisons to prevent phantom diffs on identical timestamps
      if (isDiff && dateKeys.includes(key) && INITIAL_CONFIG[key] && currentValues[key]) {
        const dOld = new Date(INITIAL_CONFIG[key]);
        const dNew = new Date(currentValues[key]);
        if (!isNaN(dOld.getTime()) && !isNaN(dNew.getTime()) && dOld.getTime() === dNew.getTime()) {
          isDiff = false;
        }
      }

      if (isDiff) {
        let displayOld = String(INITIAL_CONFIG[key]);
        let displayNew = String(currentValues[key]);

        if (dateKeys.includes(key)) {
          const dOld = new Date(INITIAL_CONFIG[key]);
          const dNew = new Date(currentValues[key]);
          if (!isNaN(dOld.getTime())) {
            displayOld = formatUtcFriendly(dOld) + '<br><span style="font-size: 0.72rem; color: var(--text-muted);">' + INITIAL_CONFIG[key] + '</span>';
          }
          if (!isNaN(dNew.getTime())) {
            displayNew = formatUtcFriendly(dNew) + '<br><span style="font-size: 0.72rem; color: #059669;">' + currentValues[key] + '</span>';
          }
        }

        diffs.push({
          key,
          label: labelMap[key] || key,
          oldVal: displayOld,
          newVal: displayNew
        });

        if (key === 'submissions_close') {
          hasCriticalChange = true;
          criticalWarning += '<div>⚠️ <strong>Submissions Deadline Changed:</strong> Directly affects participant submission access on <code>/projects/new</code>.</div>';
        }
        if (key.startsWith('weight_')) {
          hasCriticalChange = true;
          criticalWarning += '<div>⚠️ <strong>Rubric Weightings Changed:</strong> Triggers live Bayesian normalization composite score recomputation.</div>';
        }
      }
    }

    if (diffs.length === 0) {
      if (window.showToast) window.showToast('No configuration changes detected.', 'info');
      else alert('No configuration changes detected.');
      return;
    }

    // 4. Render Diff Table inside Modal
    const tbody = document.getElementById('confirm-diff-tbody');
    tbody.innerHTML = '';
    diffs.forEach(d => {
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td style="padding: 0.5rem 0.75rem; font-weight: 600;">${d.label}</td>
        <td style="padding: 0.5rem 0.75rem; font-family: var(--font-mono); color: #dc2626; word-break: break-all;">${d.oldVal || '(empty)'}</td>
        <td style="padding: 0.5rem 0.75rem; font-family: var(--font-mono); color: #059669; word-break: break-all;">${d.newVal || '(empty)'}</td>
      `;
      tbody.appendChild(tr);
    });

    // 5. Warning Box
    const warnBox = document.getElementById('confirm-warning-box');
    const warnText = document.getElementById('confirm-warning-text');
    if (hasCriticalChange) {
      warnText.innerHTML = criticalWarning;
      warnBox.style.display = 'block';
    } else {
      warnBox.style.display = 'none';
    }

    // 6. Reset confirmation input state
    document.getElementById('confirm-checkbox').checked = false;
    document.getElementById('confirm-keyword-input').value = '';
    document.getElementById('btn-final-confirm').disabled = true;

    // 7. Open Modal
    document.getElementById('double-confirm-modal').style.display = 'flex';
  }

  function validateConfirmReady() {
    const isChecked = document.getElementById('confirm-checkbox').checked;
    const keyword = document.getElementById('confirm-keyword-input').value.trim();
    const btn = document.getElementById('btn-final-confirm');
    btn.disabled = !(isChecked && keyword === 'CONFIRM');
  }

  function closeConfirmModal() {
    document.getElementById('double-confirm-modal').style.display = 'none';
  }

  function executeConfirmedSave() {
    // Pack prizes JSON
    document.getElementById('form-prizes-json').value = serializePrizes();
    document.getElementById('form-confirm-action').value = 'CONFIRM';
    document.getElementById('settings-form').submit();
  }

  function handleSettingsFormSubmit(e) {
    if (document.getElementById('form-confirm-action').value !== 'CONFIRM') {
      e.preventDefault();
      triggerSaveFlow();
    }
  }

  // --- Track Management Modals & Handlers ---
  function openTrackModal() {
    document.getElementById('track-modal-title').textContent = 'Add New Track';
    document.getElementById('track-field-id').value = '';
    document.getElementById('track-field-id').readOnly = false;
    document.getElementById('track-field-name').value = '';
    document.getElementById('track-field-prize').value = '$500';
    document.getElementById('track-field-desc').value = '';
    document.getElementById('track-confirm-keyword').value = '';
    document.getElementById('btn-save-track').disabled = true;
    document.getElementById('track-modal').style.display = 'flex';
  }

  function editTrack(id, name, desc, prize) {
    document.getElementById('track-modal-title').textContent = 'Edit Track: ' + name;
    document.getElementById('track-field-id').value = id;
    document.getElementById('track-field-id').readOnly = true;
    document.getElementById('track-field-name').value = name;
    document.getElementById('track-field-prize').value = prize;
    document.getElementById('track-field-desc').value = desc;
    document.getElementById('track-confirm-keyword').value = '';
    document.getElementById('btn-save-track').disabled = true;
    document.getElementById('track-modal').style.display = 'flex';
  }

  function validateTrackConfirm() {
    const kw = document.getElementById('track-confirm-keyword').value.trim();
    document.getElementById('btn-save-track').disabled = kw !== 'CONFIRM';
  }

  function closeTrackModal() {
    document.getElementById('track-modal').style.display = 'none';
  }

  async function submitTrackForm(e) {
    e.preventDefault();
    const id = document.getElementById('track-field-id').value.trim();
    const name = document.getElementById('track-field-name').value.trim();
    const prize = document.getElementById('track-field-prize').value.trim();
    const desc = document.getElementById('track-field-desc').value.trim();

    try {
      const res = await fetch('/api/organizer/tracks/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, name, description: desc, prize_amount: prize, confirm_action: 'CONFIRM' })
      });
      const data = await res.json();
      if (res.ok) {
        window.location.href = '/organizer/settings?tab=tracks&track_saved=1';
      } else {
        if (window.showToast) window.showToast(data.error || 'Failed to save track', 'error');
        else alert(data.error || 'Failed to save track');
      }
    } catch {
      if (window.showToast) window.showToast('Network error while saving track', 'error');
      else alert('Network error while saving track');
    }
  }

  function confirmDeleteTrack(id, name) {
    pendingDeleteTrackId = id;
    document.getElementById('delete-track-id').textContent = id;
    document.getElementById('delete-track-name').textContent = name;
    document.getElementById('delete-confirm-keyword').value = '';
    document.getElementById('btn-delete-track-submit').disabled = true;
    document.getElementById('delete-track-modal').style.display = 'flex';
  }

  function validateDeleteTrackConfirm() {
    const kw = document.getElementById('delete-confirm-keyword').value.trim();
    document.getElementById('btn-delete-track-submit').disabled = kw !== 'CONFIRM';
  }

  function closeDeleteTrackModal() {
    document.getElementById('delete-track-modal').style.display = 'none';
    pendingDeleteTrackId = null;
  }

  async function executeDeleteTrack() {
    if (!pendingDeleteTrackId) return;
    try {
      const res = await fetch('/api/organizer/tracks/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: pendingDeleteTrackId, confirm_action: 'CONFIRM' })
      });
      const data = await res.json();
      if (res.ok) {
        window.location.href = '/organizer/settings?tab=tracks&track_deleted=1';
      } else {
        if (window.showToast) window.showToast(data.error || 'Failed to delete track', 'error');
        else alert(data.error || 'Failed to delete track');
      }
    } catch {
      if (window.showToast) window.showToast('Network error while deleting track', 'error');
      else alert('Network error while deleting track');
    }
  }
</script>
