                      Edit
                    </button>
                    <button 
                      type="button" 
                      class="btn btn-secondary btn-sm" 
                      style="padding: 0.25rem 0.55rem; font-size: 0.75rem; color: #dc2626;"
                      data-track-id="<%= t.id %>"
                      data-track-name="<%= t.name %>"
                      onclick="confirmDeleteTrackFromBtn(this)"
