          <h3 style="font-size: 1.15rem; font-weight: 700; margin: 0;">Prizes Architecture &amp; Bounty Pool</h3>
          <p style="font-size: 0.85rem; color: var(--text-secondary); margin: 0.25rem 0 0 0;">
            Define overall prize pool figure, grand podium champion tiers, track bounties, and special category honors.
          </p>
        </div>
        <button type="button" class="btn btn-secondary btn-sm" onclick="addPrizeTierRow()">
          + Add Prize Tier
        </button>
      </div>
      <div class="card-body" style="padding: 1.5rem;">
        <div style="max-width: 360px; margin-bottom: 1.5rem;">
          <label class="form-label" for="field-prize-pool" style="font-weight: 600; font-size: 0.85rem; display: block; margin-bottom: 0.35rem;">
            Total Prize Pool Headline
          </label>
          <input 
            type="text" 
            id="field-prize-pool" 
            name="prize_pool" 
            class="form-input" 
            value="<%= event.prize_pool || '$50,000 USD' %>"
            placeholder="e.g. $50,000 USD"
            style="width: 100%; font-weight: 700; font-size: 1.1rem; color: #059669;"
          >
        </div>

        <div style="font-size: 0.85rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--text-primary);">
          Prize Tiers &amp; Category Allocations:
        </div>

        <div id="prizes-table-wrapper" style="overflow-x: auto;">
          <table class="data-table" style="width: 100%; text-align: left; font-size: 0.85rem;">
            <thead>
              <tr style="background: var(--bg-subtle);">
                <th style="padding: 0.65rem 0.75rem; width: 22%;">Prize Title</th>
                <th style="padding: 0.65rem 0.75rem; width: 18%;">Cash / Value</th>
                <th style="padding: 0.65rem 0.75rem;">Criteria &amp; Description</th>
                <th style="padding: 0.65rem 0.75rem; width: 80px; text-align: right;">Action</th>
              </tr>
            </thead>
            <tbody id="prizes-table-body">
              <% (prizesList || []).forEach(function(prz, idx) { %>
                <tr class="prize-row" data-index="<%= idx %>">
                  <td style="padding: 0.5rem 0.75rem;">
                    <input type="text" class="form-input prz-name" value="<%= prz.name %>" style="width: 100%; font-size: 0.82rem; padding: 0.35rem 0.5rem;">
                  </td>
                  <td style="padding: 0.5rem 0.75rem;">
                    <input type="text" class="form-input prz-amount font-mono" value="<%= prz.amount %>" style="width: 100%; font-size: 0.82rem; padding: 0.35rem 0.5rem; font-weight: 600; color: #059669;">
                  </td>
                  <td style="padding: 0.5rem 0.75rem;">
                    <input type="text" class="form-input prz-desc" value="<%= prz.description %>" style="width: 100%; font-size: 0.82rem; padding: 0.35rem 0.5rem;">
                  </td>
                  <td style="padding: 0.5rem 0.75rem; text-align: right;">
                    <button type="button" class="btn btn-secondary btn-sm" onclick="removePrizeRow(this)" style="color: #dc2626; padding: 0.25rem 0.5rem;">
                      Remove
                    </button>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- TAB 4: Tracks Management -->
  <div id="section-tracks" class="settings-section" style="display: none;">
    <div class="card" style="margin-bottom: 1.5rem;">
      <div class="card-header" style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-light); display: flex; justify-content: space-between; align-items: center;">
        <div>
          <h3 style="font-size: 1.15rem; font-weight: 700; margin: 0;">Competitive Track Categories (<%= tracks.length %> Tracks)</h3>
          <p style="font-size: 0.85rem; color: var(--text-secondary); margin: 0.25rem 0 0 0;">
            Manage hackathon problem statements, technical themes, and track-specific prize allocations.
          </p>
        </div>
        <button type="button" class="btn btn-primary btn-sm" onclick="openTrackModal()">
          + Add New Track
        </button>
      </div>
      <div class="card-body" style="padding: 0;">
        <div style="overflow-x: auto;">
          <table class="data-table" style="width: 100%; text-align: left; font-size: 0.85rem;">
            <thead>
              <tr style="background: var(--bg-subtle);">
                <th style="padding: 0.75rem 1rem; width: 100px;">Track ID</th>
                <th style="padding: 0.75rem 1rem; width: 220px;">Track Name</th>
                <th style="padding: 0.75rem 1rem;">Description / Prompt</th>
                <th style="padding: 0.75rem 1rem; width: 120px;">Track Bounty</th>
                <th style="padding: 0.75rem 1rem; width: 140px; text-align: right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% tracks.forEach(function(t) { %>
                <tr>
                  <td style="padding: 0.75rem 1rem; font-family: var(--font-mono); font-size: 0.78rem; font-weight: 600; color: var(--text-secondary);">
                    <%= t.id %>
                  </td>
                  <td style="padding: 0.75rem 1rem; font-weight: 600;">
                    <%= t.name %>
                  </td>
                  <td style="padding: 0.75rem 1rem; color: var(--text-secondary); font-size: 0.82rem;">
                    <%= t.description || 'No description provided' %>
                  </td>
                  <td style="padding: 0.75rem 1rem; font-family: var(--font-mono); font-weight: 600; color: #059669;">
                    <%= t.prize_amount || '$500' %>
                  </td>
                  <td style="padding: 0.75rem 1rem; text-align: right;">
                    <button 
                      type="button" 
                      class="btn btn-secondary btn-sm" 
                      style="padding: 0.25rem 0.55rem; font-size: 0.75rem;"
                      data-track-id="<%= t.id %>"
                      data-track-name="<%= t.name %>"
                      data-track-desc="<%= t.description || '' %>"
                      data-track-prize="<%= t.prize_amount || '$500' %>"
                      onclick="editTrackFromBtn(this)"
