<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #F8FAFC;
      --surface: #FFFFFF;
      --border: #E2E8F0;
      --text-main: #0F172A;
      --text-muted: #64748B;
      --accent: #2563EB;
      --accent-light: #EFF6FF;
      --radius: 8px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text-main);
      padding: 1rem;
      font-size: 14px;
    }
    .widget-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .widget-title {
      font-size: 1.1rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .widget-badge {
      font-size: 0.7rem;
      font-weight: 600;
      background: var(--accent-light);
      color: var(--accent);
      padding: 2px 6px;
      border-radius: 4px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .widget-controls {
      display: flex;
      gap: 0.5rem;
      width: 100%;
      margin-bottom: 1rem;
    }
    .widget-input {
      flex: 1;
      padding: 8px 12px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      font-size: 13px;
      background: var(--surface);
      outline: none;
    }
    .widget-input:focus { border-color: var(--accent); }
    .widget-select {
      padding: 8px 12px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      font-size: 13px;
      background: var(--surface);
      outline: none;
    }
    .widget-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 0.75rem;
      max-height: 480px;
      overflow-y: auto;
      padding-right: 4px;
    }
    .widget-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.85rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.15s, border-color 0.15s;
    }
    .widget-card:hover {
      border-color: #CBD5E1;
      transform: translateY(-1px);
    }
    .card-track {
      font-size: 0.7rem;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.03em;
      margin-bottom: 4px;
    }
    .card-title {
      font-size: 0.95rem;
      font-weight: 700;
      margin-bottom: 4px;
    }
    .card-title a {
      color: var(--text-main);
      text-decoration: none;
    }
    .card-title a:hover { color: var(--accent); }
    .card-desc {
      font-size: 0.8rem;
      color: var(--text-muted);
      line-height: 1.4;
      margin-bottom: 0.75rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.75rem;
      padding-top: 0.5rem;
      border-top: 1px solid #F1F5F9;
    }
    .card-team {
      font-weight: 500;
      color: var(--text-muted);
    }
    .card-link {
      color: var(--accent);
      text-decoration: none;
      font-weight: 600;
    }
    .widget-footer {
      margin-top: 1rem;
      text-align: center;
      font-size: 0.75rem;
      color: var(--text-muted);
    }
    .widget-footer a {
      color: var(--text-muted);
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div class="widget-header">
    <div class="widget-title">
      <span>PrismJudge Submissions</span>
      <span class="widget-badge"><%= projects.length %> Projects</span>
    </div>
  </div>

  <div class="widget-controls">
    <input 
      type="text" 
      id="search" 
      class="widget-input" 
      placeholder="Search projects..." 
      value="<%= searchQuery %>"
      oninput="filterWidget()"
    />
    <select id="track" class="widget-select" onchange="filterWidget()">
      <option value="">All Tracks</option>
      <% tracks.forEach(t => { %>
        <option value="<%= t.id %>" <%= currentTrack === t.id ? 'selected' : '' %>><%= t.name %></option>
      <% }) %>
    </select>
  </div>

  <div class="widget-grid" id="grid">
    <% projects.forEach(p => { %>
      <div class="widget-card" data-track="<%= p.track_id %>">
        <div>
          <div class="card-track"><%= p.track_name || 'General' %></div>
          <div class="card-title">
            <a href="/projects/<%= p.id %>" target="_blank" rel="noopener"><%= p.title %></a>
          </div>
          <p class="card-desc"><%= p.summary %></p>
        </div>
        <div class="card-footer">
          <span class="card-team"><%= p.team_name || 'Team' %></span>
          <a href="/projects/<%= p.id %>" target="_blank" rel="noopener" class="card-link">View Project &rarr;</a>
        </div>
      </div>
    <% }) %>
  </div>

  <div class="widget-footer">
    Powered by <a href="/" target="_blank" rel="noopener">PrismJudge</a> · Self-Hostable Hackathon Engine
  </div>

  <script>
    function filterWidget() {
      const q = document.getElementById('search').value.toLowerCase();
      const trk = document.getElementById('track').value;
      const cards = document.querySelectorAll('.widget-card');

      cards.forEach(c => {
        const text = c.textContent.toLowerCase();
        const cardTrack = c.getAttribute('data-track');
        const matchQ = !q || text.includes(q);
        const matchTrk = !trk || cardTrack === trk;
        c.style.display = matchQ && matchTrk ? '' : 'none';
      });
    }
  </script>
</body>
</html>
