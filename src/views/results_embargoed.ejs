<div class="page-hero" style="text-align: center; max-width: 760px; margin: 2rem auto 2.5rem auto;">
  <div style="display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: var(--radius-full); background: rgba(245, 158, 11, 0.12); color: #d97706; margin-bottom: 1.25rem; border: 1px solid rgba(245, 158, 11, 0.25);">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
    </svg>
  </div>

  <div style="font-size: 0.8rem; font-family: var(--font-mono); color: #d97706; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.5rem; font-weight: 700;">
    Under Embargo &bull; Calibration Phase
  </div>

  <h1 class="page-title" style="font-size: 2.5rem; margin-bottom: 0.75rem;">
    Competition Results Are Embargoed
  </h1>

  <p class="page-subtitle" style="font-size: 1.05rem; line-height: 1.6; color: var(--text-secondary); margin: 0 auto 1.75rem auto;">
    Evaluations, rubric consensus calculations, and Empirical Bayesian normalization are actively underway. Official award recipients, category champions, and final standings will be unveiled during the closing ceremony.
  </p>

  <div class="card" style="padding: 1.5rem; border: 1px solid rgba(245, 158, 11, 0.3); background: linear-gradient(180deg, #fffbeb 0%, var(--bg-surface) 100%); margin-bottom: 2rem; border-radius: var(--radius-lg); text-align: left;">
    <div style="display: flex; align-items: flex-start; gap: 1rem;">
      <div style="font-size: 1.75rem; line-height: 1;">🏆</div>
      <div style="flex: 1;">
        <div style="font-weight: 700; font-size: 0.95rem; color: #92400e; margin-bottom: 0.25rem;">
          Official Results Unveiling Ceremony
        </div>
        <div style="font-size: 0.88rem; color: var(--text-secondary); margin-bottom: 0.75rem;">
          The results portal will unlock publicly once the organizing committee publishes the final verified tally.
        </div>
        <div style="display: flex; align-items: center; gap: 0.5rem; font-family: var(--font-mono); font-size: 0.85rem; font-weight: 600; color: #b45309;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          <time class="local-time" datetime="<%= event?.results_announced_at || '2026-03-01T18:00:00Z' %>">
            <%= event?.results_announced_at || 'Sunday, March 1, 2026 at 6:00 PM UTC' %>
          </time>
        </div>
      </div>
    </div>
  </div>

  <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
    <a href="/projects" class="btn btn-primary" style="padding: 0.65rem 1.4rem;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
      Browse Project Gallery
    </a>
    <a href="/vote" class="btn btn-secondary" style="padding: 0.65rem 1.4rem;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
      Cast Community Ballot
    </a>
  </div>

  <% if (!user) { %>
    <div style="margin-top: 2rem; font-size: 0.8rem; color: var(--text-muted);">
      Are you an event organizer? <a href="/login?redirect=/results" style="color: var(--primary); font-weight: 600;">Sign in to preview live standings</a>
    </div>
  <% } %>
</div>
