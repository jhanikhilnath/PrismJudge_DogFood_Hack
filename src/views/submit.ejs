<%
  function formatUtcDate(isoString) {
    if (!isoString) return '';
    try {
      const d = new Date(isoString);
      return d.toLocaleDateString('en-US', {
        weekday: 'long',
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        timeZone: 'UTC'
      }) + ' at ' + d.toLocaleTimeString('en-US', {
        hour: 'numeric',
        minute: '2-digit',
        timeZoneName: 'short',
        timeZone: 'UTC'
      });
    } catch(e) {
      return isoString;
    }
  }
%>

<div class="breadcrumb-nav" style="max-width: 680px; margin-left: auto; margin-right: auto;">
  <a href="/projects" class="breadcrumb-link">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    Back to Submissions
  </a>
</div>

<div class="page-hero" style="max-width: 680px; margin: 0 auto 1.5rem; border-bottom: none; padding-bottom: 0;">
  <div>
    <h1 class="page-title">Submit a Project</h1>
    <p class="page-subtitle">Register your team's engineering entry for <%= event ? event.name : 'Sample Hack 2026' %>.</p>
  </div>
</div>

<% if (isClosed) { %>
  <div class="security-banner" style="max-width: 680px; margin: 0 auto 1.5rem; background: #FEF2F2; border-color: #FECDD3;">
    <svg class="security-icon" style="color: #DC2626;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <div class="security-text" style="color: #991B1B;">
      <strong>Submissions Window Closed:</strong> The event deadline passed on 
      <time class="local-time" datetime="<%= event ? event.submissions_close : '' %>">
        <%= event ? formatUtcDate(event.submissions_close) : 'March 1, 2026 at 6:00 PM UTC' %>
      </time>. The portal is no longer accepting new submissions or amendments.
    </div>
  </div>
<% } else { %>
  <div class="security-banner" style="max-width: 680px; margin: 0 auto 1.5rem; background: #F0FDF4; border-color: #BBF7D0;">
    <svg class="security-icon" style="color: #16A34A;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    <div class="security-text" style="color: #15803D;">
      <strong>Submissions Open:</strong> Entries are accepted until 
      <time class="local-time" datetime="<%= event ? event.submissions_close : '' %>">
        <%= event ? formatUtcDate(event.submissions_close) : 'March 1, 2026 at 6:00 PM UTC' %>
      </time>.
    </div>
  </div>
<% } %>

<div class="form-card" style="max-width: 680px; margin: 0 auto;">
  <form action="/projects/new" method="POST">
    <div class="form-group">
      <label class="form-label" for="title">Project Title</label>
      <input type="text" id="title" name="title" required class="form-input" placeholder="e.g. Glass Signal" <%= isClosed ? 'disabled' : '' %>>
    </div>

    <div class="form-group">
      <label class="form-label" for="summary">Technical Summary</label>
      <textarea id="summary" name="summary" required rows="3" class="form-textarea" placeholder="Explain the problem, architecture, and technology stack..." <%= isClosed ? 'disabled' : '' %>></textarea>
    </div>

    <div class="form-group">
      <label class="form-label" for="track_id">Target Track</label>
      <select id="track_id" name="track_id" required class="form-select" <%= isClosed ? 'disabled' : '' %>>
        <% tracks.forEach(function(t) { %>
          <option value="<%= t.id %>"><%= t.name %></option>
        <% }); %>
      </select>
    </div>

    <div class="form-group">
      <label class="form-label" for="repo_url">Repository URL</label>
      <input type="url" id="repo_url" name="repo_url" class="form-input" placeholder="https://github.com/organization/repo" <%= isClosed ? 'disabled' : '' %>>
    </div>

    <div class="form-group">
      <label class="form-label" for="demo_url">Live Deployment URL (Optional)</label>
      <input type="url" id="demo_url" name="demo_url" class="form-input" placeholder="https://..." <%= isClosed ? 'disabled' : '' %>>
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 2rem; border-top: 1px solid var(--border-light); padding-top: 1.25rem;">
      <a href="/projects" class="btn btn-secondary">Cancel</a>
      <button type="submit" class="btn btn-primary" <%= isClosed ? 'disabled' : '' %>>
        <%= isClosed ? 'Submissions Closed' : 'Submit Entry' %>
      </button>
    </div>
  </form>
</div>
