<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'DOGFOOD 2026 — Hackathon Platform' %></title>
  <link rel="stylesheet" href="/static/css/styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <header class="app-header">
    <div class="header-container">
      <div class="brand-section">
        <a href="/" class="brand-link">
          <div class="brand-glyph">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <div class="brand-text-group">
            <span class="brand-name">DOGFOOD</span>
            <span class="brand-badge">2026</span>
          </div>
        </a>
      </div>

      <!-- Role-Based Navigation: Only show tabs relevant to the user's role -->
      <% const currentUser = (typeof user !== 'undefined' && user) ? user : null; %>
      <nav class="main-nav">
        <a href="/" class="nav-link" data-path="/">Home</a>
        <a href="/projects" class="nav-link" data-path="/projects">Gallery</a>

        <% if (!currentUser || currentUser.role === 'participant') { %>
          <a href="/projects/new" class="nav-link" data-path="/projects/new">Submit</a>
        <% } %>

        <% if (currentUser && (currentUser.role === 'organizer' || currentUser.role === 'admin')) { %>
          <a href="/organizer/teams" class="nav-link" data-path="/organizer/teams">Teams</a>
        <% } %>

        <a href="/vote" class="nav-link" data-path="/vote">Ballot</a>

        <% if (currentUser && currentUser.role === 'judge') { %>
          <a href="/judge/dashboard" class="nav-link" data-path="/judge/dashboard">Judging</a>
          <a href="/judge/pairwise" class="nav-link" data-path="/judge/pairwise">Pairwise</a>
        <% } %>

        <% if (currentUser && (currentUser.role === 'organizer' || currentUser.role === 'admin')) { %>
          <a href="/organizer/dashboard" class="nav-link" data-path="/organizer/dashboard">Console</a>
        <% } %>
      </nav>

      <div class="auth-section">
        <% if (typeof user !== 'undefined' && user) { %>
          <!-- Authenticated User Profile Menu (De-slopped: No raw token dumps) -->
          <div class="profile-menu-wrapper">
            <button type="button" class="profile-trigger" id="profile-dropdown-btn">
              <span class="avatar-circle <%= user.role %>">
                <%= (user.name || user.role).charAt(0).toUpperCase() %>
              </span>
              <span class="profile-info">
                <span class="profile-name"><%= user.name || user.userId %></span>
                <span class="badge-role badge-<%= user.role %>"><%= user.role.toUpperCase() %></span>
              </span>
              <svg class="chevron-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </button>

            <div class="profile-dropdown" id="profile-dropdown-content">
              <div class="dropdown-header">
                <div class="dropdown-user-name"><%= user.name %></div>
                <div class="dropdown-user-email"><%= user.email %></div>
              </div>

              <div class="dropdown-section-title">Switch Persona</div>
              
              <a href="/api/auth/switch/organizer" class="dropdown-item <%= user.role === 'organizer' ? 'active-item' : '' %>">
                <span class="item-tag tag-org">ORG</span>
                <span>Lead Organizer</span>
              </a>
              <a href="/api/auth/switch/judge_a" class="dropdown-item <%= user.role === 'judge' && user.userId === 'jdg_01' ? 'active-item' : '' %>">
                <span class="item-tag tag-judge">JDG</span>
                <span>Judge A (Tomas)</span>
              </a>
              <a href="/api/auth/switch/judge_b" class="dropdown-item <%= user.role === 'judge' && user.userId === 'jdg_02' ? 'active-item' : '' %>">
                <span class="item-tag tag-judge">JDG</span>
                <span>Judge B (Elena)</span>
              </a>
              <a href="/api/auth/switch/participant" class="dropdown-item <%= user.role === 'participant' ? 'active-item' : '' %>">
                <span class="item-tag tag-part">PRT</span>
                <span>Participant (Team 01)</span>
              </a>

              <% if (user.role === 'participant') { %>
                <div class="dropdown-divider"></div>
                <a href="/certificates/prj_01" class="dropdown-item">
                  <span class="item-tag tag-part">CERT</span>
                  <span>My Team Certificate</span>
                </a>
              <% } %>

              <div class="dropdown-divider"></div>
              <a href="/logout" class="dropdown-item dropdown-logout">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Sign Out
              </a>
            </div>
          </div>
        <% } else { %>
          <!-- Unauthenticated Sign In Button & Demo Trigger -->
          <div class="auth-buttons" style="display: flex; align-items: center; gap: 0.5rem;">
            <a href="/login" class="btn btn-secondary btn-sm">Sign In</a>
            <div class="demo-menu-wrapper">
              <button type="button" class="btn btn-primary btn-sm" id="demo-dropdown-btn">
                Demo Personas ▾
              </button>
              <div class="profile-dropdown" id="demo-dropdown-content">
                <div class="dropdown-section-title">Select Demo Persona</div>
                <a href="/api/auth/switch/organizer" class="dropdown-item">
                  <span class="item-tag tag-org">ORG</span>
                  <span>Lead Organizer</span>
                </a>
                <a href="/api/auth/switch/judge_a" class="dropdown-item">
                  <span class="item-tag tag-judge">JDG</span>
                  <span>Judge A (Tomas)</span>
                </a>
                <a href="/api/auth/switch/judge_b" class="dropdown-item">
                  <span class="item-tag tag-judge">JDG</span>
                  <span>Judge B (Elena)</span>
                </a>
                <a href="/api/auth/switch/participant" class="dropdown-item">
                  <span class="item-tag tag-part">PRT</span>
                  <span>Participant (Team 01)</span>
                </a>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </header>

  <main class="app-main">
    <%- body %>
  </main>

  <footer class="app-footer">
    <div class="footer-container">
      <div class="footer-left">
        <div class="footer-status">
          <span>&copy; 2026 Sample Hackathon. All rights reserved.</span>
        </div>
        <p class="footer-caption">Built for transparent peer evaluation and high-integrity competition judging.</p>
      </div>
      <div class="footer-right">
        <a href="/projects" class="footer-link">Projects</a>
        <a href="/vote" class="footer-link">Community Ballot</a>
        <% if (user && user.role === 'organizer') { %>
          <a href="/docs" target="_blank" class="footer-link">API Docs</a>
        <% } %>
        <span class="footer-badge">Sample Hack 2026</span>
      </div>
    </div>
  </footer>

  <div id="toast-container"></div>
  <script src="/static/js/app.js"></script>
</body>
</html>
