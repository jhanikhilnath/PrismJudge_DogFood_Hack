<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'DOGFOOD 2026' %></title>
  <link rel="stylesheet" href="/static/css/styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;800&family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>
  <header class="app-header">
    <div class="header-container">
      <div class="brand-section">
        <span class="logo-badge">DOGFOOD</span>
        <a href="/projects" class="logo-title">HACKATHON PORTAL</a>
      </div>

      <nav class="main-nav">
        <a href="/projects">Gallery</a>
        <a href="/projects/new">Submit</a>
        <a href="/vote">Vote (T3)</a>
        <a href="/judge/dashboard">Judge (T2)</a>
        <a href="/judge/pairwise">Pairwise</a>
        <a href="/organizer/dashboard">Organizer</a>
        <a href="/docs" target="_blank">API Docs</a>
      </nav>

      <div class="role-switcher">
        <span class="label">Test Role:</span>
        <a href="/api/auth/switch/organizer" class="role-pill <%= typeof user !== 'undefined' && user && user.role === 'organizer' ? 'active' : '' %>" title="Organizer (org_7f2a)">Org</a>
        <a href="/api/auth/switch/judge_a" class="role-pill <%= typeof user !== 'undefined' && user && user.role === 'judge' && user.userId === 'jdg_01' ? 'active' : '' %>" title="Judge A (jdg_a_91bc)">Judge A</a>
        <a href="/api/auth/switch/judge_b" class="role-pill <%= typeof user !== 'undefined' && user && user.role === 'judge' && user.userId === 'jdg_02' ? 'active' : '' %>" title="Judge B (jdg_b_44de)">Judge B</a>
        <a href="/api/auth/switch/participant" class="role-pill <%= typeof user !== 'undefined' && user && user.role === 'participant' ? 'active' : '' %>" title="Participant (prt_2e88)">Part</a>
      </div>
    </div>
  </header>

  <main class="app-main">
    <%- body %>
  </main>

  <footer class="app-footer">
    <p>DOGFOOD 2026 Hackathon Platform · Open Source under MIT License · Offline-First Engine</p>
    <p style="margin-top: 0.35rem; color: #475569;">"Build the platform that will judge you."</p>
  </footer>

  <script src="/static/js/app.js"></script>
</body>
</html>
