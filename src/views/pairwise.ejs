<div class="page-hero">
  <div class="hero-content">
    <h1 class="page-title">Pairwise Arena</h1>
    <p class="page-subtitle">
      Compare two projects side-by-side using the Bradley-Terry Maximum Likelihood model.
    </p>
  </div>
</div>

<div class="normalization-card">
  <div class="normalization-header">
    <div class="normalization-title-group">
      <span class="norm-indicator-dot"></span>
      <h3 class="normalization-title">Bradley-Terry Maximum Likelihood Estimator</h3>
    </div>
    <span class="norm-pill">PAIRWISE</span>
  </div>
  <p class="normalization-desc">
    Pairwise judgments fit latent project skill ratings via Majorization-Minimization (MM) iterations, eliminating individual judge rubric scaling disparities and anchoring relative project quality.
  </p>
</div>

<% if (project_a && project_b) { %>
  <div class="pairwise-arena-grid">
    <!-- Project A -->
    <div class="pairwise-card">
      <div>
        <span class="card-track-name" style="margin-bottom: 0.5rem;"><%= project_a.track_name || 'Track' %></span>
        <h2 style="font-size: 1.35rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 0.75rem; color: var(--text-primary);"><%= project_a.title %></h2>
        <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.55;"><%= project_a.summary %></p>
      </div>
      <div style="margin-top: 2rem;">
        <button type="button" class="btn btn-primary" style="width: 100%;" onclick="submitPairwiseVote('<%= project_a.id %>', '<%= project_b.id %>', 'project_a')">
          Select <%= project_a.title %> →
        </button>
      </div>
    </div>

    <!-- Center VS Divider -->
    <div class="pairwise-vs-divider">
      <div class="vs-line"></div>
      <span class="vs-label">VS</span>
      <button type="button" class="btn btn-secondary btn-sm" onclick="submitPairwiseVote('<%= project_a.id %>', '<%= project_b.id %>', 'tie')">
        Declare Tie
      </button>
      <div class="vs-line"></div>
    </div>

    <!-- Project B -->
    <div class="pairwise-card">
      <div>
        <span class="card-track-name" style="margin-bottom: 0.5rem;"><%= project_b.track_name || 'Track' %></span>
        <h2 style="font-size: 1.35rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 0.75rem; color: var(--text-primary);"><%= project_b.title %></h2>
        <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.55;"><%= project_b.summary %></p>
      </div>
      <div style="margin-top: 2rem;">
        <button type="button" class="btn btn-primary" style="width: 100%;" onclick="submitPairwiseVote('<%= project_a.id %>', '<%= project_b.id %>', 'project_b')">
          Select <%= project_b.title %> →
        </button>
      </div>
    </div>
  </div>
<% } else { %>
  <div class="empty-state-card">
    <div class="empty-state-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
    </div>
    <h3 class="empty-state-title">Comparison Pair Unavailable</h3>
    <p class="empty-state-desc">Not enough active projects are available to generate a pairwise showdown match.</p>
  </div>
<% } %>

<script>
  async function submitPairwiseVote(projA, projB, winner) {
    try {
      const res = await fetch('/api/pairwise/vote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ project_a: projA, project_b: projB, winner: winner })
      });

      if (res.ok) {
        if (window.showToast) window.showToast('Comparison recorded!', 'success');
        setTimeout(() => window.location.reload(), 250);
      } else {
        const err = await res.json();
        if (window.showToast) {
          window.showToast(err.error || 'Failed to submit match', 'error');
        } else {
          alert('Error: ' + (err.error || 'Failed to submit match'));
        }
      }
    } catch (e) {
      if (window.showToast) window.showToast('Network error while recording comparison', 'error');
    }
  }
</script>
