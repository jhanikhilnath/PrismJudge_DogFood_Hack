<div class="page-hero">
  <div>
    <div class="badge-role badge-judge" style="margin-bottom: 0.5rem; display: inline-block;">PAIRWISE ARENA</div>
    <h1 class="page-title">Head-to-Head Comparison</h1>
    <p class="page-subtitle">Compare two projects side-by-side using the Bradley-Terry Minorization-Maximization (MM) model</p>
  </div>
</div>

<div class="normalization-card" style="margin-bottom: 2rem;">
  <div class="normalization-header">
    <div class="normalization-title-group">
      <span class="norm-indicator-dot"></span>
      <h3 class="normalization-title">Bradley-Terry Maximum Likelihood Estimator Active</h3>
    </div>
    <span class="norm-pill">PAIRWISE MLE</span>
  </div>
  <p class="normalization-desc">
    Pairwise comparisons fit latent project skill ratings λᵢ via MM iterations, effectively neutralizing individual judge rubric scaling biases and strictness disparities.
  </p>
</div>

<% if (project_a && project_b) { %>
  <div class="pairwise-arena-grid">
    <!-- Project A -->
    <div class="pairwise-card">
      <div class="card-inner-shell" style="height: 100%; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span class="card-track"><%= project_a.track_name || 'Track' %></span>
          <h2 class="pairwise-project-title"><%= project_a.title %></h2>
          <p class="pairwise-project-summary"><%= project_a.summary %></p>
        </div>
        <div style="margin-top: 2rem;">
          <button type="button" class="btn btn-primary" style="width: 100%; padding: 0.85rem;" onclick="submitPairwiseVote('<%= project_a.id %>', '<%= project_b.id %>', 'project_a')">
            ★ Select <%= project_a.title %>
          </button>
        </div>
      </div>
    </div>

    <!-- Center VS Divider -->
    <div class="pairwise-vs-divider">
      <div class="vs-line"></div>
      <span class="vs-label">VS</span>
      <button type="button" class="btn btn-secondary btn-sm" onclick="submitPairwiseVote('<%= project_a.id %>', '<%= project_b.id %>', 'tie')">
        Declare Tie
      </button>
      <div class="vs-line"></div>
    </div>

    <!-- Project B -->
    <div class="pairwise-card">
      <div class="card-inner-shell" style="height: 100%; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span class="card-track"><%= project_b.track_name || 'Track' %></span>
          <h2 class="pairwise-project-title"><%= project_b.title %></h2>
          <p class="pairwise-project-summary"><%= project_b.summary %></p>
        </div>
        <div style="margin-top: 2rem;">
          <button type="button" class="btn btn-primary" style="width: 100%; padding: 0.85rem;" onclick="submitPairwiseVote('<%= project_a.id %>', '<%= project_b.id %>', 'project_b')">
            ★ Select <%= project_b.title %>
          </button>
        </div>
      </div>
    </div>
  </div>
<% } else { %>
  <div class="empty-state-card">
    <p style="color: var(--text-muted);">Not enough active projects to generate a comparison match.</p>
  </div>
<% } %>

<script>
  async function submitPairwiseVote(projA, projB, winner) {
    const res = await fetch('/api/pairwise/vote', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ project_a: projA, project_b: projB, winner: winner })
    });

    if (res.ok) {
      window.location.reload();
    } else {
      const err = await res.json();
      alert('Pairwise error: ' + (err.error || 'Failed to submit match'));
    }
  }
</script>
