<%
  function getTrackInfo(trackName) {
    const t = (trackName || '').toLowerCase();
    if (t.includes('sec')) return { cls: 'track-sec', icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>' };
    if (t.includes('clim')) return { cls: 'track-climate', icon: '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>' };
    if (t.includes('health')) return { cls: 'track-health', icon: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>' };
    if (t.includes('data')) return { cls: 'track-data', icon: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>' };
    if (t.includes('hard') || t.includes('hw')) return { cls: 'track-hw', icon: '<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/>' };
    if (t.includes('edu')) return { cls: 'track-edu', icon: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>' };
    if (t.includes('dev') || t.includes('tool')) return { cls: 'track-dev', icon: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>' };
    if (t.includes('access')) return { cls: 'track-access', icon: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>' };
    return { cls: 'track-default', icon: '<circle cx="12" cy="12" r="10"/><polygon points="12 8 8 12 12 16 16 12 12 8"/>' };
  }
%>

<div class="page-hero">
  <div class="hero-content">
    <h1 class="page-title">Community Choice Ballot</h1>
    <p class="page-subtitle">
      Cast your vote for the community choice award. Project display order is randomized per session to prevent presentation bias.
    </p>
  </div>
</div>

<div class="security-banner">
  <svg class="security-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
  <div class="security-text">
    <strong>Privacy Guard:</strong> Real-time vote tallies remain sealed until the voting window officially closes to ensure untampered outcomes.
  </div>
</div>

<!-- Search & Track Toolbar -->
<div class="filter-toolbar">
  <div class="search-bar-row">
    <div class="search-input-wrapper">
      <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input 
        type="text" 
        id="ballot-search" 
        placeholder="Search ballot entries by title, team, or keywords..." 
        class="search-input" 
      >
      <kbd class="search-kbd">/</kbd>
    </div>
  </div>

  <% if (typeof tracks !== 'undefined' && tracks.length > 0) { %>
    <div class="track-pills-container" id="ballot-track-pills">
      <button type="button" class="track-pill-btn active" data-track-id="">
        All Tracks <span class="pill-count">(<%= projects.length %>)</span>
      </button>
      <% tracks.forEach(function(t) { 
           const count = projects.filter(p => p.track_id === t.id).length;
      %>
        <button type="button" class="track-pill-btn" data-track-id="<%= t.id %>">
          <%= t.name %> <span class="pill-count">(<%= count %>)</span>
        </button>
      <% }); %>
    </div>
  <% } %>
</div>

<div class="grid-cards" id="ballot-grid">
  <% projects.forEach(function(p) { 
       const info = getTrackInfo(p.track_name || p.track_id);
  %>
    <div class="project-card" data-title="<%= p.title.toLowerCase() %>" data-summary="<%= p.summary.toLowerCase() %>" data-track="<%= p.track_id %>" data-team="<%= (p.team_name || p.team_id || '').toLowerCase() %>">
      <div class="card-header-banner <%= info.cls %>">
        <svg class="card-pattern-svg" viewBox="0 0 100 100" preserveAspectRatio="none">
          <defs>
            <pattern id="vote-grid-<%= p.id %>" width="12" height="12" patternUnits="userSpaceOnUse">
              <path d="M 12 0 L 0 0 0 12" fill="none" stroke="currentColor" stroke-width="0.75" />
            </pattern>
          </defs>
          <rect width="100" height="100" fill="url(#vote-grid-<%= p.id %>)" />
        </svg>

        <div class="card-track-glyph">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <%- info.icon %>
          </svg>
        </div>

        <span class="card-id-tag"><%= p.id %></span>
      </div>

      <div class="card-body <%= info.cls %>">
        <span class="card-track-name"><%= p.track_name || 'General' %></span>
        <h2 class="card-title">
          <a href="/projects/<%= p.id %>"><%= p.title %></a>
        </h2>
        <p class="card-summary"><%= p.summary %></p>

        <div class="card-footer" style="flex-direction: column; align-items: stretch; gap: 0.65rem; padding-top: 1rem;">
          <div class="team-chip" style="margin-bottom: 0.25rem;">
            <span class="team-avatar-mini"><%= (p.team_name || 'T').charAt(0).toUpperCase() %></span>
            <span><%= p.team_name || p.team_id %></span>
          </div>
          <% 
            const isOwnTeam = typeof userTeamProjectId !== 'undefined' && userTeamProjectId === p.id;
            const hasVoted = typeof userVotedProjectIds !== 'undefined' ? userVotedProjectIds.includes(p.id) : (userVotedProjectId === p.id);
            if (isOwnTeam) {
          %>
            <button class="btn btn-secondary" disabled style="width: 100%; color: var(--text-muted); background: var(--bg-surface-elevated); cursor: default;">
              Your Team Entry
            </button>
          <% } else if (hasVoted) { %>
            <button class="btn btn-secondary" disabled style="width: 100%; border-color: #A7F3D0; color: #065F46; background: #ECFDF5; cursor: default;">
              ✓ You Voted For This
            </button>
          <% } else { %>
            <form onsubmit="castVote(event, '<%= p.id %>')">
              <button type="submit" class="btn btn-primary" style="width: 100%;" <%= isVotingClosed ? 'disabled' : '' %>>
                <%= isVotingClosed ? 'Voting Closed' : 'Vote for Project' %>
              </button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  <% }); %>
</div>

<div id="no-ballots-banner" class="empty-state-card" style="display: none; margin-top: 2rem;">
  <div class="empty-state-icon">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
  </div>
  <h3 class="empty-state-title">No matching entries found</h3>
  <p class="empty-state-desc">Try clearing your search query or switching to another track filter.</p>
  <button type="button" class="btn btn-secondary btn-sm" id="btn-clear-ballot-filters">Clear Filters</button>
</div>

<script>
  async function castVote(e, projectId) {
    e.preventDefault();
    const btn = e.target.querySelector('button');
    if (btn) {
      btn.disabled = true;
      btn.textContent = 'Recording ballot...';
    }
    try {
      const res = await fetch('/api/vote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ project_id: projectId })
      });

      if (res.ok) {
        if (window.showToast) window.showToast('Your ballot has been securely cast!', 'success');
        if (btn) {
          btn.outerHTML = '<button class="btn btn-secondary" disabled style="width: 100%; border-color: #A7F3D0; color: #065F46; background: #ECFDF5; cursor: default;">✓ You Voted For This</button>';
        }
      } else {
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Vote for Project';
        }
        const err = await res.json();
        if (window.showToast) {
          window.showToast(err.error || 'Failed to record vote', 'error');
        }
      }
    } catch (e) {
      if (btn) {
        btn.disabled = false;
        btn.textContent = 'Vote for Project';
      }
      if (window.showToast) window.showToast('Network error while casting ballot', 'error');
    }
  }

  // Client-side ballot filtering
  document.addEventListener('DOMContentLoaded', () => {
    const ballotSearch = document.getElementById('ballot-search');
    const trackPills = document.querySelectorAll('#ballot-track-pills .track-pill-btn');
    const cards = document.querySelectorAll('#ballot-grid .project-card');
    const noBanner = document.getElementById('no-ballots-banner');
    const clearBtn = document.getElementById('btn-clear-ballot-filters');
    let currentTrack = '';

    function filterBallots() {
      const q = ballotSearch ? ballotSearch.value.toLowerCase().trim() : '';
      let visible = 0;
      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const summary = card.getAttribute('data-summary') || '';
        const team = card.getAttribute('data-team') || '';
        const track = card.getAttribute('data-track') || '';

        const matchesQuery = !q || title.includes(q) || summary.includes(q) || team.includes(q);
        const matchesTrack = !currentTrack || track === currentTrack;

        if (matchesQuery && matchesTrack) {
          card.style.display = '';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });
      if (noBanner) noBanner.style.display = visible === 0 ? 'block' : 'none';
    }

    if (ballotSearch) {
      ballotSearch.addEventListener('input', filterBallots);
    }

    trackPills.forEach(pill => {
      pill.addEventListener('click', () => {
        trackPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        currentTrack = pill.getAttribute('data-track-id') || '';
        filterBallots();
      });
    });

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (ballotSearch) ballotSearch.value = '';
        currentTrack = '';
        trackPills.forEach(p => p.classList.toggle('active', !p.getAttribute('data-track-id')));
        filterBallots();
      });
    }
  });
</script>
